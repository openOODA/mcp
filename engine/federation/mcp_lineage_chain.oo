// # MCP Adversarial Lineage: Hash-Chained NDJSON + Periodic Re-Attest
//
// Logline: Every lineage entry carries entryHash = SHA-256(version|sha|prevSha|prevEntryHash|boardCount|epoch). Read-back recomputes the chain and reports "ok" or "tamper@<idx>". Rehash the codex from disk on a fixed epoch interval so cache.sha cannot lie about the substrate past the boundary.
//
// Setup: mcp_lineage_append_chained is the production append path. mcp_lineage_record calls it inline so every recorded lineage event is tamper-evident. The chain is rooted at "" for entry 0; any pre-existing raw entry is detected as "tamper@0" by verify, which is the correct fail-closed behavior (no compat, no migration). Periodic re-attest interval is env-driven via $OODAREATTEST_INTERVAL (default 10).
//
// Beats:
//   1. mcp_lineage_append_chained: append with computed hash.
//   2. mcp_lineage_verify: read the whole log, recompute, return "ok" or "tamper@<idx>".
//   3. mcp_reattest_if_due: re-attest when the interval has elapsed.
//   4. mcp_reattest_interval_from_env: read $OODAREATTEST_INTERVAL, default 10.

import "std/fs/file_writer.oo";

fn lineage_chain_path() -> String { return "openOODA/mcp-lineage.jsonl"; }
fn lineage_chain_version() -> String { return mcp_protocol_version(); }

// Low-level hash. All inputs are stringified so verification can replay it from JSON text.
fn compute_hash(version: String, sha: String, prev_sha: String, prev_entry_hash: String, board_count_str: String, epoch_str: String) -> String {
    let payload: String = version + "|" + sha + "|" + prev_sha + "|" + prev_entry_hash + "|" + board_count_str + "|" + epoch_str;
    let h: String = crypto_sha256_internal(payload);
    if chars_len(h) == 64 { return h; }
    return "";
}

// Public entry-hash. Int params stringified internally; same payload format as verify replay.
pub fn mcp_lineage_entry_hash(version: String, sha: String, prev_sha: String, prev_entry_hash: String, board_count: Int, epoch: Int) -> String {
    return compute_hash(version, sha, prev_sha, prev_entry_hash, board_count.to_string(), epoch.to_string());
}

// Extract a string field by key from a JSON object. Returns "" if missing.
fn extract_string(s: String, key: String) -> String {
    let needle: String = "\"" + key + "\":\"";
    let kpos: Int = str_index_of(s, needle);
    if kpos < 0 { return ""; }
    let start: Int = kpos + chars_len(needle);
    let qpos: Int = str_index_of(str_slice(s, start, chars_len(s)), "\"");
    if qpos < 0 { return ""; }
    return str_slice(s, start, start + qpos);
}

// Extract an int field by key. Returns "" if missing.
fn extract_int_string(s: String, key: String) -> String {
    let needle: String = "\"" + key + "\":";
    let kpos: Int = str_index_of(s, needle);
    if kpos < 0 { return ""; }
    let start: Int = kpos + chars_len(needle);
    let n: Int = chars_len(s);
    let mut end: Int = start;
    while end < n {
        let c: String = char_at(s, end);
        if !char_is_digit(c) { break; }
        end = end + 1;
    }
    if end == start { return ""; }
    return str_slice(s, start, end);
}

// Read the entryHash of the most recent entry. Returns "" if the log is empty or the latest entry has no entryHash.
pub fn mcp_lineage_latest_entry_hash(fs: &FsReadCap) -> String {
    let path: String = lineage_chain_path();
    if !path_exists(fs, path) { return ""; }
    let rr: Result[String, String] = read_file(fs, path);
    if rr.is_err() { return ""; }
    let text: String = match rr { Ok(s) => s, Err(_) => "" };
    let n: Int = chars_len(text);
    if n == 0 { return ""; }
    let mut end: Int = n;
    while end > 0 && char_at(text, end - 1) == "\n" {
        end = end - 1;
    }
    if end == 0 { return ""; }
    let mut start: Int = end - 1;
    while start > 0 && char_at(text, start - 1) != "\n" {
        start = start - 1;
    }
    let last: String = str_slice(text, start, end);
    return extract_string(last, "entryHash");
}

// Append a chained entry. Returns the new entryHash on success, "" on failure.
pub fn mcp_lineage_append_chained(fw: &FsWriteCap, fr: &FsReadCap, sha: String, prev_sha: String, board_count: Int, epoch: Int) -> String {
    let mk_res: Result[Void, String] = oo_fs_mkdir(fw, "openOODA");
    let prev_entry_hash: String = mcp_lineage_latest_entry_hash(fr);
    let version: String = lineage_chain_version();
    let h: String = mcp_lineage_entry_hash(version, sha, prev_sha, prev_entry_hash, board_count, epoch);
    if chars_len(h) != 64 { return ""; }
    let line: String = "{\"version\":\"" + version + "\",\"sha\":\"" + sha + "\",\"prevSha\":\"" + prev_sha + "\",\"boardCount\":" + board_count.to_string() + ",\"epoch\":" + epoch.to_string() + ",\"entryHash\":\"" + h + "\"}\n";
    let writer: FileWriter = file_writer_open(fw, lineage_chain_path(), true);
    let ar: Result[FileWriter, String] = file_writer_append(fw, fr, writer, line);
    if ar.is_err() { return ""; }
    return h;
}

// Verify the chain. Reads the whole log, recomputes each entry's hash from (content + previous entryHash), returns "ok" or "tamper@<idx>".
pub fn mcp_lineage_verify(fs: &FsReadCap) -> String {
    let path: String = lineage_chain_path();
    if !path_exists(fs, path) { return "ok"; }
    let rr: Result[String, String] = read_file(fs, path);
    if rr.is_err() { return "ok"; }
    let text: String = match rr { Ok(s) => s, Err(_) => "" };
    if chars_len(text) == 0 { return "ok"; }
    let n: Int = chars_len(text);
    let mut prev_hash: String = "";
    let mut cur_idx: Int = 0;
    let mut line_start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        let at_end: Bool = i == n;
        let is_nl: Bool = !at_end && char_at(text, i) == "\n";
        if at_end || is_nl {
            if i > line_start {
                let entry: String = str_slice(text, line_start, i);
                let version: String = extract_string(entry, "version");
                let sha: String = extract_string(entry, "sha");
                let prev_sha: String = extract_string(entry, "prevSha");
                let bc_s: String = extract_int_string(entry, "boardCount");
                let ep_s: String = extract_int_string(entry, "epoch");
                let entry_hash_field: String = extract_string(entry, "entryHash");
                let computed: String = compute_hash(version, sha, prev_sha, prev_hash, bc_s, ep_s);
                if computed != entry_hash_field { return "tamper@" + cur_idx.to_string(); }
                prev_hash = entry_hash_field;
                cur_idx = cur_idx + 1;
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    return "ok";
}

// Parse a string of digits to int. Returns `default_val` if empty, contains non-digits, or is 0.
pub fn mcp_parse_int(s: String, default_val: Int) -> Int {
    let n: Int = chars_len(s);
    if n == 0 { return default_val; }
    let mut result: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if !char_is_digit(c) { return default_val; }
        result = result * 10 + (byte_at(c, 0) - byte_at("0", 0));
        i = i + 1;
    }
    if result == 0 { return default_val; }
    return result;
}

// Read the re-attest interval from $OODAREATTEST_INTERVAL. Default 10.
pub fn mcp_reattest_interval_from_env(env: &EnvCap) -> Int {
    let r: Result[String, String] = env_get(env, "OODAREATTEST_INTERVAL");
    if r.is_err() { return 10; }
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    return parse_int(v, 10);
}

// Env-driven epoch interval for periodic re-attest.
pub fn mcp_reattest_interval(env: &EnvCap) -> Int {
    return mcp_reattest_interval_from_env(env);
}

// Re-attest if the interval has elapsed. Returns 1 if a re-attest ran, 0 if it was not yet due.
pub fn mcp_reattest_if_due(fs: &FsReadCap, env: &EnvCap, cache: &mut McpCodexCache, current_epoch: Int) -> Int {
    if current_epoch - cache.last_attested_epoch < mcp_reattest_interval(env) { return 0; }
    let _: Int = mcp_codex_re_attest(fs, env, cache);
    cache.last_attested_epoch = current_epoch;
    return 1;
}
