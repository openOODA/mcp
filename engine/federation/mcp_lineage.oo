// # MCP Lineage: Versioned LLMS.oot History + Coherence-Cache Invalidation
//
// Logline: Every change to LLMS.oot is appended to a NDJSON lineage log; clients can query by SHA prefix or by index. On every record, the dynamic graph and federated cache are invalidated so the system stays version-coherent.
//
// Setup: Append-only NDJSON file at openOODA/mcp-lineage.jsonl. Each line is a JSON object with version, sha, prev_sha, board_count, epoch, entryHash (the chain is in mcp_lineage_chain.oo).
//
// Beats:
//   1. mcp_lineage_record appends a new chained entry to the lineage log.
//   2. mcp_lineage_query looks up an entry by SHA prefix.
//   3. mcp_lineage_at_index returns the n-th entry (0-indexed).
//   4. mcp_lineage_count returns the number of entries.
//   5. mcp_lineage_latest_sha returns the SHA of the most recent entry.
//   6. mcp_lineage_invalidate_caches clears the dynamic graph and federated cache on every record.

import "engine/state/mcp_graph_dynamic.oo";
import "engine/federation/mcp_codex.oo";
import "engine/federation/mcp_lineage_chain.oo";
import "std/fs/file_writer.oo";

fn lineage_path() -> String { return "openOODA/mcp-lineage.jsonl"; }
fn lineage_version() -> String { return mcp_protocol_version(); }

// Append a new chained lineage entry. The prev_sha is "" for the first entry.
// The append is hash-chained (mcp_lineage_append_chained writes an entryHash field
// that includes the previous entry's entryHash). After the append, the G14
// lineage-coherence hook clears the dynamic graph and invalidates the federated
// cache so the system stays version-coherent.
pub fn mcp_lineage_record(fw: &FsWriteCap, fr: &FsReadCap, cache: &mut McpCodexCache, dynamic: &mut McpDynamicGraph, sha: String, prev_sha: String, board_count: Int, epoch: Int) -> String {
    let h: String = mcp_lineage_append_chained(fw, fr, sha, prev_sha, board_count, epoch);
    if chars_len(h) != 64 { return ""; }
    let _: String = mcp_lineage_invalidate_caches(cache, dynamic);
    return sha;
}

// Read the entire lineage log. Returns "" when the file is absent.
pub fn mcp_lineage_read(fs: &FsReadCap) -> String {
    let path: String = lineage_path();
    if !path_exists(fs, path) { return ""; }
    let rr: Result[String, String] = read_file(fs, path);
    if rr.is_err() { return ""; }
    return match rr { Ok(s) => s, Err(_) => "" };
}

// Count the number of entries in the lineage log.
pub fn mcp_lineage_count(fs: &FsReadCap) -> Int {
    let text: String = mcp_lineage_read(fs);
    if chars_len(text) == 0 { return 0; }
    let mut count: Int = 0;
    let n: Int = chars_len(text);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" { count = count + 1; }
        i = i + 1;
    }
    return count;
}

// Extract the n-th entry (0-indexed). Returns "" if out of range.
pub fn mcp_lineage_at_index(fs: &FsReadCap, idx: Int) -> String {
    let text: String = mcp_lineage_read(fs);
    if chars_len(text) == 0 { return ""; }
    let mut cur_idx: Int = 0;
    let n: Int = chars_len(text);
    let mut start: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" {
            if cur_idx == idx { return str_slice(text, start, i); }
            cur_idx = cur_idx + 1;
            start = -1;
        } else {
            if start < 0 { start = i; }
        }
        i = i + 1;
    }
    return "";
}

// Find the first entry whose sha starts with `prefix`. Returns "" if not found.
pub fn mcp_lineage_query(fs: &FsReadCap, prefix: String) -> String {
    let count: Int = mcp_lineage_count(fs);
    let mut i: Int = 0;
    while i < count {
        let entry: String = mcp_lineage_at_index(fs, i);
        if chars_len(entry) > 0 {
            if str_starts_with(entry, "{\"version\":\"" + lineage_version() + "\",\"sha\":\"" + prefix) {
                return entry;
            }
        }
        i = i + 1;
    }
    return "";
}

// True iff the lineage log contains an entry with the given exact sha.
pub fn mcp_lineage_has(fs: &FsReadCap, sha: String) -> Bool {
    let count: Int = mcp_lineage_count(fs);
    let mut i: Int = 0;
    while i < count {
        let entry: String = mcp_lineage_at_index(fs, i);
        if str_contains(entry, "\"sha\":\"" + sha + "\"") { return true; }
        i = i + 1;
    }
    return false;
}

// Get the SHA of the most recent entry. Returns "" if the log is empty.
pub fn mcp_lineage_latest_sha(fs: &FsReadCap) -> String {
    let count: Int = mcp_lineage_count(fs);
    if count == 0 { return ""; }
    let entry: String = mcp_lineage_at_index(fs, count - 1);
    let key: String = "\"sha\":\"";
    let kpos: Int = str_index_of(entry, key);
    if kpos < 0 { return ""; }
    let start: Int = kpos + chars_len(key);
    let qpos: Int = str_index_of(str_slice(entry, start, chars_len(entry)), "\"");
    if qpos < 0 { return ""; }
    return str_slice(entry, start, start + qpos);
}

// Invalidate the dynamic graph and the federated cache. Called on every lineage record.
pub fn mcp_lineage_invalidate_caches(cache: &mut McpCodexCache, dynamic: &mut McpDynamicGraph) -> String {
    let fresh: McpDynamicGraph = mcp_dynamic_new();
    dynamic.entries = fresh.entries;
    dynamic.hot = fresh.hot;
    dynamic.cold = fresh.cold;
    dynamic.unused = fresh.unused;
    dynamic.shadow = fresh.shadow;
    dynamic.fold_epoch = 0;
    cache.federated_stale = true;
    cache.federated_graph_json = "";
    return "ok";
}
