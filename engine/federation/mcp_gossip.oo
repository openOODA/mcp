// # MCP Gossip: Abstraction + Unix-Socket + Multi-Host TCP Transports
//
// Logline: Multiple ooda mcp instances exchange McpDynamicGraph deltas to converge on a shared knowledge base. Transport layer: abstract state, plus Unix-socket (single-host) and TCP (multi-host) implementations.
//
// Setup: Pure functional over the dynamic graph. Dedup is by (kind, name) — repeated records are merged by max(count). Unix-socket needs BindCap+FsCap+FsWriteCap; TCP needs TcpCap+BindCap. No threads (runtime doesn't expose them yet); sequential multiple-accept / multiple-retry per call.
//
// Beats:
//   1. mcp_gossip_new, mcp_gossip_merge, mcp_gossip_delta, mcp_gossip_has_merged: abstract state.
//   2. mcp_gossip_socket_path + mcp_gossip_publish + mcp_gossip_fetch: Unix-socket single-host.
//   3. mcp_gossip_tcp_publish + mcp_gossip_tcp_fetch: TCP multi-host.
//   4. mcp_gossip_tcp_publish_long_lived + mcp_gossip_tcp_fetch_long_lived: G21S multiple-accept.
//   5. mcp_gossip_fed_tcp_publish: G22W auto-publish on $OODAFED_TCP_PORT if set.

import "engine/state/mcp_graph_dynamic.oo";
import "std/net/unix_socket.oo";
import "std/net/tcp_conn.oo";

type McpGossipState = struct {
    instance_id: String,
    fold_epoch: Int,
    merged_entries: Int
};

pub fn mcp_gossip_new(instance_id: String) -> McpGossipState {
    return McpGossipState { instance_id: instance_id, fold_epoch: 0, merged_entries: 0 };
}

// Fold + dedup the graph by (kind, name), keeping the entry with the higher count
// and the latest last_seen. Returns the number of unique entries after dedup.
// Z-77 (V6): dedup loop was O(n²) for n entries (inner scan per outer entry). First-principles:
// mcp_dynamic_record pre-dedupes (it looks up by (kind,name) and increments count). The dedup
// loop in this merge was scanning entries that are already unique. The O(n²) was theoretical
// waste, not functional bug. Replaced with O(n) fold: the contract is "merge is fold + count",
// not "dedup-rewrite".
pub fn mcp_gossip_merge(g: &mut McpDynamicGraph, state: &mut McpGossipState, epoch: Int) -> Int {
    let entries: List[McpUsageEntry] = g.entries;
    let n: Int = list_len(entries);
    state.merged_entries = n;
    state.fold_epoch = epoch;
    mcp_dynamic_fold(g, epoch);
    return n;
}

// Build an outbound delta — a JSON snapshot of the current entries.
pub fn mcp_gossip_delta(state: &McpGossipState, g: &McpDynamicGraph) -> String {
    let fe: Int = state.fold_epoch;
    let epoch: String = fe.to_string();
    let iid: String = lsp_jsonrpc_escape(state.instance_id);
    let mut entries_json: String = "[";
    let entries: List[McpUsageEntry] = g.entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { entries_json = entries_json + ","; }
        let e: McpUsageEntry = list_get(entries, i);
        let ek: Int = e.kind;
        let k: String = ek.to_string();
        let ec: Int = e.count;
        let c: String = ec.to_string();
        let ets: Int = e.last_seen_epoch;
        let ts: String = ets.to_string();
        let n_safe: String = lsp_jsonrpc_escape(e.name);
        entries_json = entries_json + "{\"kind\":" + k + ",\"name\":\"" + n_safe + "\",\"count\":" + c + ",\"lastSeen\":" + ts + "}";
        i = i + 1;
    }
    entries_json = entries_json + "]";
    return "{\"instance\":\"" + iid + "\",\"foldEpoch\":" + epoch + ",\"entries\":" + entries_json + "}";
}

// True iff the gossip state has observed at least one merge.
pub fn mcp_gossip_has_merged(state: &McpGossipState) -> Bool {
    return state.merged_entries > 0;
}

// ── Unix-socket transport (single-host) ──
fn gossip_socket_dir() -> String { return "openOODA/mcp-sockets"; }

// Z-80 (V6): defense-in-depth — reject instance_id with anything outside [a-zA-Z0-9-].
// The canonical instance_id is "<8hex>-<int>" (from mcp_server_run:191). Path traversal
// via "../" or "/" is rejected at the source.
pub fn mcp_gossip_socket_path(instance_id: String) -> String {
    if !mcp_gossip_id_is_safe(instance_id) { return gossip_socket_dir() + "/INVALID.sock"; }
    return gossip_socket_dir() + "/" + instance_id + ".sock";
}

fn mcp_gossip_id_is_safe(id: String) -> Bool {
    let n: Int = chars_len(id);
    if n == 0 { return false; }
    if n > 64 { return false; }
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(id, i);
        let is_digit: Bool = c >= "0" && c <= "9";
        let is_lower: Bool = c >= "a" && c <= "z";
        let is_upper: Bool = c >= "A" && c <= "Z";
        let is_dash: Bool = c == "-";
        if !is_digit && !is_lower && !is_upper && !is_dash { return false; }
        i = i + 1;
    }
    return true;
}

pub fn mcp_gossip_publish(bind: &BindCap, fw: &FsWriteCap, fs: &FsCap, instance_id: String, graph_json: String) -> Int {
    let path: String = mcp_gossip_socket_path(instance_id);
    let mk_res: Result[Void, String] = oo_fs_mkdir(fw, gossip_socket_dir());
    let br: Result[UnixSocketHandle, String] = unix_socket_bind(bind, fw, path);
    if br.is_err() { return 0; }
    let listener: UnixSocketHandle = match br { Ok(h) => h, Err(_) => UnixSocketHandle { fd: 0, path: "", is_open: false } };
    let ar: Result[UnixConnection, String] = unix_socket_accept(fs, listener);
    if ar.is_err() { let _: Int = unix_socket_close_listener(fs, fw, listener); return 0; }
    let conn: UnixConnection = match ar { Ok(c) => c, Err(_) => UnixConnection { fd: 0, path: "", is_open: false } };
    let written: Int = unix_socket_write(fs, conn, graph_json);
    let _: Int = unix_socket_close_connection(fs, fw, conn);
    let _: Int = unix_socket_close_listener(fs, fw, listener);
    if written <= 0 { return 0; }
    return 1;
}

pub fn mcp_gossip_fetch(fs: &FsCap, fw: &FsWriteCap, instance_id: String) -> String {
    let path: String = mcp_gossip_socket_path(instance_id);
    let cr: Result[UnixConnection, String] = unix_socket_connect(fs, fw, path);
    if cr.is_err() { return ""; }
    let conn: UnixConnection = match cr { Ok(c) => c, Err(_) => UnixConnection { fd: 0, path: "", is_open: false } };
    let rr: Result[String, String] = unix_socket_read(fs, conn, 65536);
    let data: String = match rr { Ok(s) => s, Err(_) => "" };
    let _: Int = unix_socket_close_connection(fs, fw, conn);
    return data;
}

pub fn mcp_gossip_round_trip(bind: &BindCap, fw: &FsWriteCap, fs: &FsCap, instance_id: String, graph_json: String) -> String {
    let _ = mcp_gossip_publish(bind, fw, fs, instance_id, graph_json);
    return mcp_gossip_fetch(fs, fw, instance_id);
}

// ── TCP transport (multi-host) ──
pub fn mcp_gossip_tcp_publish(bind: &BindCap, tcp: &TcpCap, host: String, port: Int, instance_id: String, graph_json: String) -> Int {
    let br: Result[TcpListener, String] = tcp_conn_bind(bind, host, port);
    if br.is_err() { return 0; }
    let listener: TcpListener = match br { Ok(l) => l, Err(_) => return 0; };
    let ar: Result[TcpConnection, String] = tcp_conn_accept(tcp, listener);
    if ar.is_err() { let _ = tcp_conn_close_listener(tcp, listener); return 0; }
    let conn: TcpConnection = match ar { Ok(c) => c, Err(_) => { let _ = tcp_conn_close_listener(tcp, listener); return 0; } };
    let iid: String = lsp_jsonrpc_escape(instance_id);
    let body: String = "{\"instance\":\"" + iid + "\",\"transport\":\"tcp\",\"graph\":" + graph_json + "}";
    let wr: Result[TcpConnection, String] = tcp_conn_write(tcp, conn, body);
    let wrote: Bool = if wr.is_err() { false } else { true };
    let _ = tcp_conn_close(tcp, conn);
    let _ = tcp_conn_close_listener(tcp, listener);
    if !wrote { return 0; }
    return 1;
}

pub fn mcp_gossip_tcp_fetch(tcp: &TcpCap, host: String, port: Int) -> String {
    let cr: Result[TcpConnection, String] = tcp_conn_open(tcp, host, port);
    if cr.is_err() { return ""; }
    let conn: TcpConnection = match cr { Ok(c) => c, Err(_) => return ""; };
    let rr: Result[String, String] = tcp_conn_read(tcp, conn, 65536);
    let data: String = match rr { Ok(s) => s, Err(_) => "" };
    let _ = tcp_conn_close(tcp, conn);
    return data;
}

pub fn mcp_gossip_tcp_round_trip(bind: &BindCap, tcp: &TcpCap, host: String, port: Int, instance_id: String, graph_json: String) -> String {
    let _ = mcp_gossip_tcp_publish(bind, tcp, host, port, instance_id, graph_json);
    return mcp_gossip_tcp_fetch(tcp, host, port);
}

// Long-lived TCP publisher: bind once, accept up to max_accepts clients.
pub fn mcp_gossip_tcp_publish_long_lived(bind: &BindCap, tcp: &TcpCap, host: String, port: Int, instance_id: String, graph_json: String, max_accepts: Int) -> Int {
    if max_accepts < 1 { return 0; }
    let br: Result[TcpListener, String] = tcp_conn_bind(bind, host, port);
    if br.is_err() { return 0; }
    let listener: TcpListener = match br { Ok(l) => l, Err(_) => return 0; };
    let iid: String = lsp_jsonrpc_escape(instance_id);
    let body: String = "{\"instance\":\"" + iid + "\",\"transport\":\"tcp\",\"graph\":" + graph_json + "}";
    let mut served: Int = 0;
    let mut k: Int = 0;
    while k < max_accepts {
        let ar: Result[TcpConnection, String] = tcp_conn_accept(tcp, listener);
        if ar.is_err() { break; }
        let conn: TcpConnection = match ar { Ok(c) => c, Err(_) => break; };
        let wr: Result[TcpConnection, String] = tcp_conn_write(tcp, conn, body);
        if wr.is_ok() { served = served + 1; }
        let closed_conn: TcpConnection = match wr { Ok(c) => c, Err(_) => conn };
        let _ = tcp_conn_close(tcp, closed_conn);
        k = k + 1;
    }
    let _ = tcp_conn_close_listener(tcp, listener);
    return served;
}

// Long-lived TCP fetcher: retry up to max_attempts.
pub fn mcp_gossip_tcp_fetch_long_lived(tcp: &TcpCap, host: String, port: Int, max_attempts: Int) -> String {
    if max_attempts < 1 { return ""; }
    let mut out: String = "";
    let mut k: Int = 0;
    while k < max_attempts {
        let cr: Result[TcpConnection, String] = tcp_conn_open(tcp, host, port);
        if cr.is_err() { k = k + 1; continue; }
        let conn: TcpConnection = match cr { Ok(c) => c, Err(_) => { k = k + 1; continue; } };
        let rr: Result[String, String] = tcp_conn_read(tcp, conn, 65536);
        let data: String = match rr { Ok(s) => s, Err(_) => "" };
        let _ = tcp_conn_close(tcp, conn);
        if chars_len(data) > 0 { out = data; break; }
        k = k + 1;
    }
    return out;
}

// Auto-publish on $OODAFED_TCP_PORT if set.
pub fn mcp_gossip_fed_tcp_publish(env: &EnvCap, bind: &BindCap, tcp: &TcpCap, instance_id: String, graph_json: String) -> Int {
    let r: Result[String, String] = env_get(env, "OODAFED_TCP_PORT");
    if r.is_err() { return 1; }
    let v: String = match r { Ok(s) => s, Err(_) => "" };
    let n: Int = chars_len(v);
    if n == 0 { return 1; }
    let mut port: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(v, i);
        if !char_is_digit(c) { return 1; }
        port = port * 10 + (byte_at(c, 0) - byte_at("0", 0));
        i = i + 1;
    }
    if port <= 0 { return 1; }
    let served: Int = mcp_gossip_tcp_publish_long_lived(bind, tcp, "0.0.0.0", port, instance_id, graph_json, 1);
    if served <= 0 { return 0; }
    return 1;
}
