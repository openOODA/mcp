// # MCP Codex Loader
//
// Logline: Resolve $OODACODEX, read it, SHA-256 it, and cache the graph keyed by path and size.
//
// Setup: EnvCap for OODACODEX. No path fallback. Missing file fails closed with return 0.
//
// Beats:
//   1. Honour $OODACODEX only.
//   2. Read under FsReadCap and hash.
//   3. Cache hit skips re-hash when path and size match.

import "engine/state/mcp_graph.oo";

pub fn mcp_codex_path_env(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODACODEX");
    if r.is_ok() {
        let v: String = match r { Ok(s) => s, Err(_) => "" };
        if chars_len(v) > 0 { return v; }
    }
    return "";
}

pub fn mcp_codex_dirname(path: String) -> String {
    let n: Int = chars_len(path);
    let mut i: Int = n - 1;
    while i >= 0 {
        if char_at(path, i) == "/" { return str_slice(path, 0, i); }
        i = i - 1;
    }
    return "";
}

pub fn mcp_codex_resolve_path(fs: &FsReadCap, env: &EnvCap) -> String {
    let p: String = mcp_codex_path_env(env);
    if chars_len(p) == 0 { return ""; }
    if !path_exists(fs, p) { return ""; }
    return p;
}

pub type McpCodexCache = struct {
    path: String,
    size_bytes: Int,
    text: String,
    sha: String,
    graph: McpGraph
};

pub fn mcp_codex_cache_new() -> McpCodexCache {
    return McpCodexCache {
        path: "",
        size_bytes: 0,
        text: "",
        sha: "",
        graph: mcp_graph_canonical("", "")
    };
}

pub fn mcp_codex_resolve_cached(fs: &FsReadCap, env: &EnvCap, cache: &mut McpCodexCache) -> Int {
    let p: String = mcp_codex_resolve_path(fs, env);
    if chars_len(p) == 0 { return 0; }
    let sz: Int = file_size(fs, p);
    if p == cache.path && sz == cache.size_bytes && chars_len(cache.sha) == 64 {
        return 1;
    }
    let rr: Result[String, String] = read_file(fs, p);
    if rr.is_err() { return 0; }
    let text: String = match rr { Ok(v) => v, Err(_) => "" };
    if chars_len(text) == 0 { return 0; }
    let sha: String = crypto_sha256_internal(text);
    if chars_len(sha) != 64 { return 0; }
    cache.path = p;
    cache.size_bytes = sz;
    cache.text = text;
    cache.sha = sha;
    cache.graph = mcp_graph_canonical(sha, mcp_codex_dirname(p));
    return 2;
}
