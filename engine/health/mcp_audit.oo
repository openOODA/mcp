// # MCP Append-Only Audit Log
//
// Logline: Hash-chain every dispatch on the session, persist under FsWriteCap, serve the last N entries.
//
// Setup: SHA-256 over a canonical body. Missing persist file is not a pass of verify.
//
// Beats:
//   1. Record one chained entry.
//   2. Tail the in-memory log.
//   3. Persist JSONL under .ooda-cache/.
//   4. Verify the on-disk chain fail-closed.

import "engine/core/mcp_json.oo";
import "std/fs/file/file_writer.oo";
import "std/fs/file/file_reader.oo";

pub type McpAuditEntry = struct {
    epoch: Int,
    method: String,
    id: String,
    decision: Int,
    code: Int,
    caps_before: Int,
    caps_after: Int,
    revoked: String,
    prev_sha: String,
    sha: String
};

pub fn mcp_audit_log_path() -> String {
    return ".ooda-cache/mcp-audit.jsonl";
}

pub fn mcp_audit_entry_new(epoch: Int, method: String, id: String, decision: Int, code: Int, caps_before: Int, caps_after: Int, revoked: String, prev_sha: String, sha: String) -> McpAuditEntry {
    return McpAuditEntry { epoch: epoch, method: method, id: id, decision: decision, code: code, caps_before: caps_before, caps_after: caps_after, revoked: revoked, prev_sha: prev_sha, sha: sha };
}

pub fn mcp_audit_entry_body(entry: &McpAuditEntry) -> String {
    return entry.epoch.to_string() + "|" + entry.method + "|" + entry.id + "|" + entry.decision.to_string() + "|" + entry.code.to_string() + "|" + entry.caps_before.to_string() + "|" + entry.caps_after.to_string() + "|" + entry.revoked + "|" + entry.prev_sha + "|" + entry.sha;
}

pub fn mcp_audit_entry_to_json(entry: &McpAuditEntry) -> String {
    return "{\"epoch\":" + entry.epoch.to_string() + ",\"method\":\"" + mcp_json_escape(entry.method) + "\",\"id\":\"" + mcp_json_escape(entry.id) + "\",\"decision\":" + entry.decision.to_string() + ",\"code\":" + entry.code.to_string() + ",\"caps_before\":" + entry.caps_before.to_string() + ",\"caps_after\":" + entry.caps_after.to_string() + ",\"revoked\":\"" + mcp_json_escape(entry.revoked) + "\",\"prev_sha\":\"" + entry.prev_sha + "\",\"sha\":\"" + entry.sha + "\"}";
}

pub fn mcp_audit_record(s: &mut McpSession, epoch: Int, method: String, id: String, decision: Int, code: Int, caps_before: Int, caps_after: Int, revoked: String) -> String {
    let prev_sha: String = s.audit_chain_head;
    let mut entry: McpAuditEntry = mcp_audit_entry_new(epoch, method, id, decision, code, caps_before, caps_after, revoked, prev_sha, "");
    let h: String = crypto_sha256_internal(mcp_audit_entry_body(&entry));
    entry.sha = h;
    s.audit_log = list_push(s.audit_log, entry);
    s.audit_chain_head = h;
    return h;
}

pub fn mcp_audit_tail(s: &McpSession, n: Int) -> String {
    let total: Int = list_len(s.audit_log);
    if total == 0 { return "[]"; }
    let start: Int = if n <= 0 || n >= total { 0 } else { total - n };
    let mut out: String = "[";
    let mut i: Int = start;
    let mut first: Bool = true;
    while i < total {
        if !first { out = out + ","; }
        out = out + mcp_audit_entry_to_json(&list_get(s.audit_log, i));
        first = false;
        i = i + 1;
    }
    return out + "]";
}

pub fn mcp_audit_persist(fw: &FsWriteCap, s: &McpSession) -> Int {
    let writer: FileWriter = file_writer_open(fw, mcp_audit_log_path(), true);
    let total: Int = list_len(s.audit_log);
    let mut i: Int = 0;
    while i < total {
        let _: Result[FileWriter, String] = file_writer_write(fw, writer, mcp_audit_entry_to_json(&list_get(s.audit_log, i)) + "\n");
        i = i + 1;
    }
    return total;
}

pub fn mcp_audit_compact(s: &mut McpSession, keep_last_n: Int) -> Int {
    let total: Int = list_len(s.audit_log);
    if keep_last_n <= 0 || total <= keep_last_n { return 0; }
    let mut kept: List[McpAuditEntry] = list_new();
    let mut i: Int = total - keep_last_n;
    while i < total {
        kept = list_push(kept, list_get(s.audit_log, i));
        i = i + 1;
    }
    s.audit_log = kept;
    if list_len(kept) > 0 {
        let last: McpAuditEntry = list_get(kept, list_len(kept) - 1);
        s.audit_chain_head = last.sha;
    } else {
        s.audit_chain_head = "";
    }
    return total - keep_last_n;
}

pub fn mcp_audit_verify(fs: &FsReadCap) -> Bool {
    let ro: Result[FileReader, String] = file_reader_open(fs, mcp_audit_log_path());
    if ro.is_err() { return false; }
    let r: FileReader = match ro { Ok(v) => v, Err(_) => return false; };
    let lr: Result[List[String], String] = file_reader_lines(fs, r);
    if lr.is_err() { return false; }
    let lines: List[String] = match lr { Ok(v) => v, Err(_) => return false; };
    let total: Int = list_len(lines);
    let mut prev_sha: String = "";
    let mut any: Bool = false;
    let mut i: Int = 0;
    while i < total {
        let line: String = list_get(lines, i);
        if chars_len(line) > 0 {
            any = true;
            let method: String = mcp_json_extract_string(line, "method");
            let id: String = mcp_json_extract_string(line, "id");
            let sha: String = mcp_json_extract_string(line, "sha");
            let prev: String = mcp_json_extract_string(line, "prev_sha");
            if prev != prev_sha { return false; }
            let e: McpAuditEntry = mcp_audit_entry_new(mcp_json_extract_int(line, "epoch"), method, id, mcp_json_extract_int(line, "decision"), mcp_json_extract_int(line, "code"), mcp_json_extract_int(line, "caps_before"), mcp_json_extract_int(line, "caps_after"), mcp_json_extract_string(line, "revoked"), prev, sha);
            if crypto_sha256_internal(mcp_audit_entry_body(&e)) != sha { return false; }
            prev_sha = sha;
        }
        i = i + 1;
    }
    return any;
}
