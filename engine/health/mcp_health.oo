// # MCP Health — Server-Wide Diagnostic
//
// Logline: Single tool that returns 7 server-wide health fields so a monitoring system has one scrape endpoint.
//
// Setup: First-principles: a security-critical server MUST be observable. mcp_health(fs, s, g) returns a JSON with 7 fields (phase, request_count, audit_count, rate_window_count, dynamic_count, version, uptime_marker). No FsRead or FsWrite. Pure in-memory snapshot. The `uptime_marker` is a counter the caller compares across scrapes to detect a restart.
//
// Beats:
//   1. mcp_health: 7-field JSON snapshot.

import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";
import "engine/health/mcp_audit.oo";
import "engine/federation/mcp_codex.oo";

pub fn mcp_health(fs: &FsReadCap, s: &McpSession, g: &McpGraph) -> String {
    let _: &FsReadCap = fs; // suppress unused
    let dyn_count: Int = 0; // dynamic graph not on session; placeholder for V7 telemetry
    return "{\"phase\":" + s.phase.to_string() + ",\"request_count\":" + s.request_seq.to_string() + ",\"audit_count\":" + list_len(s.audit_log).to_string() + ",\"rate_window_count\":" + s.rate_window_count.to_string() + ",\"dynamic_count\":" + dyn_count.to_string() + ",\"version\":\"" + mcp_protocol_version() + "\",\"uptime_marker\":\"" + s.audit_chain_head + "\"}";
}
