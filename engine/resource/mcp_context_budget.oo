// # MCP Context Budget
//
// Logline: Index boards, truncate board text, truncate the codex, and snapshot session counters.
//
// Setup: summarize_board reads under FsReadCap using graph.board_root. Compress is truncation.
//
// Beats:
//   1. Board index from the graph.
//   2. Summarize one board.
//   3. Compress orientation text.
//   4. Session context snapshot.

import "engine/core/mcp_json.oo";
import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";
import "engine/tool/mcp_tool.oo";

pub fn mcp_context_budget_get_board_index(g: &McpGraph) -> String {
    let brds: List[McpBoard] = g.boards;
    let n: Int = list_len(brds);
    let mut out: String = "[";
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + ","; }
        let b: McpBoard = list_get(brds, i);
        out = out + "{\"name\":\"" + b.name + "\",\"path\":\"" + b.path + "\",\"priority\":" + b.read_priority.to_string() + ",\"summary_chars\":" + chars_len(b.summary).to_string() + "}";
        i = i + 1;
    }
    return out + "]";
}

pub fn mcp_context_budget_summarize_board(fs: &FsReadCap, g: &McpGraph, name: String, max_chars: Int) -> String {
    if max_chars <= 0 { return "{\"error\":\"max_chars must be > 0\"}"; }
    let brds: List[McpBoard] = g.boards;
    let n: Int = list_len(brds);
    let mut i: Int = 0;
    while i < n {
        let b: McpBoard = list_get(brds, i);
        if b.name == name {
            let path: String = mcp_tool_board_path(g, b.path);
            let rr: Result[String, String] = read_file(fs, path);
            if rr.is_err() { return "{\"error\":\"cannot read\",\"path\":\"" + path + "\"}"; }
            let text: String = match rr { Ok(s) => s, Err(_) => "" };
            return mcp_context_budget_truncate(text, max_chars, "board:" + name);
        }
        i = i + 1;
    }
    return "{\"error\":\"board not found\",\"name\":\"" + name + "\"}";
}

pub fn mcp_context_budget_compress_orient(codex_text: String, max_chars: Int) -> String {
    if max_chars <= 0 { return "{\"error\":\"max_chars must be > 0\"}"; }
    return mcp_context_budget_truncate(codex_text, max_chars, "orient");
}

pub fn mcp_context_budget_get_context(s: &McpSession) -> String {
    return "{\"bytes_in\":" + s.bytes_in.to_string() + ",\"bytes_out\":" + s.bytes_out.to_string() + ",\"request_seq\":" + s.request_seq.to_string() + ",\"caps_held\":" + s.caps_held.to_string() + ",\"rate_window_count\":" + s.rate_window_count.to_string() + ",\"audit_count\":" + list_len(s.audit_log).to_string() + ",\"pending_notifs\":" + list_len(s.pending_notifications).to_string() + ",\"seen_ids\":" + list_len(s.seen_ids).to_string() + ",\"client_roots\":" + list_len(s.client_roots).to_string() + ",\"token_prompt_tokens\":" + s.token_prompt_tokens.to_string() + ",\"token_calls\":" + s.token_calls.to_string() + "}";
}

fn mcp_context_budget_truncate(text: String, max_chars: Int, kind: String) -> String {
    let n: Int = chars_len(text);
    if n <= max_chars {
        return "{\"kind\":\"" + kind + "\",\"truncated\":false,\"orig_chars\":" + n.to_string() + ",\"returned_chars\":" + n.to_string() + ",\"text\":\"" + mcp_json_escape(text) + "\"}";
    }
    return "{\"kind\":\"" + kind + "\",\"truncated\":true,\"orig_chars\":" + n.to_string() + ",\"returned_chars\":" + max_chars.to_string() + ",\"text\":\"" + mcp_json_escape(str_slice(text, 0, max_chars)) + "\"}";
}
