// # MCP JSON-RPC 2.0 Batch Request Handler
//
// Logline: A batch is a JSON array of request objects. We split it into top-level {…} items, run each through mcp_server_handle_body, and collect the responses into a result array. Notifications (no "id") produce no response item (per JSON-RPC 2.0).
//
// Setup: Pure functional on the JSON body string. No caps needed. Brace-depth scan respects string boundaries and backslash escapes.
//
// Beats:
//   1. mcp_batch_is_batch: true if body starts with '[' and ends with ']'.
//   2. mcp_batch_split: extract each top-level {…} between [ and ].
//   3. mcp_batch_collect: join response strings into a result array.

// F-07: detect a JSON-RPC 2.0 batch (array) vs a single request object.
pub fn mcp_batch_is_batch(body: String) -> Bool {
    let n: Int = chars_len(body);
    if n < 2 { return false; }
    if char_at(body, 0) != "[" { return false; }
    if char_at(body, n - 1) != "]" { return false; }
    return true;
}

// F-07: split a batch array into individual JSON-object strings.
// Tracks brace depth, ignoring braces inside string literals and backslash-escaped chars.
pub fn mcp_batch_split(body: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = chars_len(body);
    if n < 2 { return out; }
    if char_at(body, 0) != "[" { return out; }
    let mut depth: Int = 0;
    let mut in_string: Bool = false;
    let mut escape: Bool = false;
    let mut start: Int = 0 - 1;
    let mut i: Int = 1;
    while i < n - 1 {
        let c: String = char_at(body, i);
        if escape { escape = false; i = i + 1; continue; }
        if in_string && c == "\\" { escape = true; i = i + 1; continue; }
        if c == "\"" { in_string = !in_string; i = i + 1; continue; }
        if !in_string {
            if c == "{" {
                if depth == 0 { start = i; }
                depth = depth + 1;
            } else if c == "}" {
                if depth > 0 { depth = depth - 1; }
                if depth == 0 && start >= 0 {
                    out = list_push(out, str_slice(body, start, i + 1));
                    start = 0 - 1;
                }
            }
        }
        i = i + 1;
    }
    return out;
}

// F-07: collect per-request responses into a batch result array. Skips empty strings (notifications).
pub fn mcp_batch_collect(responses: List[String]) -> String {
    let mut out: String = "[";
    let n: Int = list_len(responses);
    let mut i: Int = 0;
    while i < n {
        let s: String = list_get(responses, i);
        if chars_len(s) > 0 {
            if out != "[" { out = out + ","; }
            out = out + s;
        }
        i = i + 1;
    }
    return out + "]";
}

// F-07: true if the item is a notification (no "id" field). JSON-RPC 2.0 says notifications get no response.
pub fn mcp_batch_is_notification(item: String) -> Bool {
    return !str_contains(item, "\"id\":");
}
