// # MCP Live Stdio Loop
//
// Logline: Poll stdin in chunks, dispatch one JSON-RPC frame, print one framed response, until exit or hangup.
//
// Setup: Uses oo_read_stdin_chunk. Timeout and EOF are the same Err. Idle 5 minutes is hangup. print has no extra newline.
//
// Beats:
//   1. Load OODACODEX. Fail closed if missing.
//   2. While a complete frame is in the buffer, dispatch and print.
//   3. Otherwise poll stdin. Err and empty increment idle. Idle cap is hangup.
//   4. Frame cap 256 and 1MiB fail closed. Audit persist on every exit.

import "engine/core/mcp_server.oo";
import "engine/core/mcp_session.oo";
import "engine/core/mcp_transport.oo";
import "engine/core/mcp_json.oo";
import "engine/core/mcp_batch.oo";
import "engine/federation/mcp_codex.oo";
import "engine/health/mcp_audit.oo";
import "engine/tool/mcp_tool_exec.oo";

pub fn mcp_stdio_poll_ms() -> Int { return 1; }
pub fn mcp_stdio_idle_iters() -> Int { return 300000; }

fn mcp_stdio_finish(fw: &FsWriteCap, s: &McpSession, rc: Result[Int, String]) -> Result[Int, String] {
    let _: Int = mcp_audit_persist(fw, s);
    return rc;
}

pub fn mcp_stdio_serve(fw: &FsWriteCap, fs: &FsReadCap, env: &EnvCap, p: &ProcessCap) -> Result[Int, String] {
    let mut cache: McpCodexCache = mcp_codex_cache_new();
    let cached: Int = mcp_codex_resolve_cached(fs, env, &mut cache);
    if cached == 0 { return Err("OODACODEX missing or unreadable"); }
    let mut session: McpSession = mcp_session_new();
    session.exec_oodac = mcp_exec_resolve_compiler(fs, env);
    let mut buf: String = "";
    let mut total: Int = 0;
    let mut frames: Int = 0;
    let mut idle: Int = 0;
    while true {
        let fr: McpFrame = mcp_transport_take(buf);
        if mcp_frame_is_ok(&fr) {
            buf = mcp_frame_rest(&fr);
            let body: String = mcp_frame_body(&fr);
            idle = 0;
            if chars_len(body) == 0 { continue; }
            frames = frames + 1;
            if frames > 256 { return mcp_stdio_finish(fw, &session, Err("frame cap 256")); }
            let resp: String = if mcp_batch_is_batch(body) { mcp_server_handle_batch(fs, &mut session, &cache.graph, cache.text, body, p) } else { mcp_server_handle_body(fs, &mut session, &cache.graph, cache.text, body, p) };
            if chars_len(resp) > 0 {
                if bytes_len(resp) > 1048576 { return mcp_stdio_finish(fw, &session, Err("response exceeds 1MiB")); }
                print(mcp_json_frame(resp));
            }
            if session.phase == mcp_phase_closed() || session.phase == mcp_phase_down() {
                return mcp_stdio_finish(fw, &session, Ok(0));
            }
            continue;
        }
        if total > 1048576 { return mcp_stdio_finish(fw, &session, Err("input exceeds 1MiB")); }
        let r: Result[String, String] = oo_read_stdin_chunk(fs, mcp_stdio_poll_ms());
        if !r.is_ok() {
            idle = idle + 1;
            if idle > mcp_stdio_idle_iters() {
                return mcp_stdio_finish(fw, &session, Ok(0));
            }
            continue;
        }
        let chunk: String = match r { Ok(s) => s, Err(_) => "" };
        if chars_len(chunk) == 0 {
            idle = idle + 1;
            if idle > mcp_stdio_idle_iters() {
                return mcp_stdio_finish(fw, &session, Ok(0));
            }
        } else {
            buf = buf + chunk;
            total = total + bytes_len(chunk);
            idle = 0;
            let mut more: Bool = true;
            while more && total <= 1048576 {
                let r0: Result[String, String] = oo_read_stdin_chunk(fs, 0);
                if r0.is_ok() {
                    let extra: String = match r0 { Ok(s) => s, Err(_) => "" };
                    if chars_len(extra) > 0 {
                        buf = buf + extra;
                        total = total + bytes_len(extra);
                    } else {
                        more = false;
                    }
                } else {
                    more = false;
                }
            }
        }
    }
    return mcp_stdio_finish(fw, &session, Ok(0));
}
