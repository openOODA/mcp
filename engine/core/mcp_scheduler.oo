// # Runtime Scheduler Facade
//
// Logline: Spawn, cancel, sleep, and periodic-spawn over the runtime scheduler builtins. The runtime exposes runtime_spawn, runtime_cancel, runtime_sleep_ms, runtime_spawn_periodic. This .oo facade is production; the runtime replaces the stub bodies with the real thread-pool implementation.
//
// Setup: Pure facade. Each function delegates to a runtime builtin. Returns McpTaskHandle for spawn operations.
//
// Beats:
//   1. mcp_spawn: spawn a background task.
//   2. mcp_cancel: cancel a spawned task.
//   3. mcp_sleep_ms: sleep the current thread.
//   4. mcp_spawn_periodic: spawn a periodic task.

fn runtime_spawn(fn_ptr: Int, args: Int) -> Int { return 0 - 1; }
fn runtime_cancel(handle: Int) -> Int { return 0 - 1; }
fn runtime_sleep_ms(ms: Int) -> Int { return 0; }
fn runtime_spawn_periodic(fn_ptr: Int, args: Int, interval_ms: Int) -> Int { return 0 - 1; }

pub type McpTaskHandle = struct {
    handle: Int,
    is_periodic: Bool
};

// Spawn a background task. Returns the handle struct (handle=0-1 on failure).
pub fn mcp_spawn(fn_ptr: Int, args: Int) -> McpTaskHandle {
    let h: Int = runtime_spawn(fn_ptr, args);
    if h < 0 { return McpTaskHandle { handle: 0 - 1, is_periodic: false }; }
    return McpTaskHandle { handle: h, is_periodic: false };
}

// Cancel a spawned task. Returns 0 on success, 1 if already done, 2 if not found.
pub fn mcp_cancel(t: McpTaskHandle) -> Int {
    if t.handle < 0 { return 2; }
    return runtime_cancel(t.handle);
}

// Sleep the current thread for ms milliseconds.
pub fn mcp_sleep_ms(ms: Int) -> Int {
    return runtime_sleep_ms(ms);
}

// Spawn a periodic task. Returns the handle struct.
pub fn mcp_spawn_periodic(fn_ptr: Int, args: Int, interval_ms: Int) -> McpTaskHandle {
    let h: Int = runtime_spawn_periodic(fn_ptr, args, interval_ms);
    if h < 0 { return McpTaskHandle { handle: 0 - 1, is_periodic: false }; }
    return McpTaskHandle { handle: h, is_periodic: true };
}
