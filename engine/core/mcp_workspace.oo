// # MCP Workspace — Board-Routed Knowledge Primitives
//
// Logline: Expose 6 board-routed knowledge primitives so the LLM client can pull specific process boards (NORTHSTAR, SECURITY, REDTEAM, WORKFLOW, STRUCTURE_EM, ROADMAP+SHIPPED) by name instead of guessing the ooda:// URI.
//
// Setup: Tier 4 of the blue-ocean MCP expansion. Each tool wraps the existing read_board logic with a typed entry point. The LLM no longer needs to know all 13 board names; it asks for the one it needs by purpose. get_milestone_status merges ROADMAP (current) with SHIPPED (completed) for a unified status view.
//
// Beats:
//   1. mcp_workspace_get_northstar — read the NORTHSTAR board (mission + design principles).
//   2. mcp_workspace_get_security_threat_model — read SECURITY (threat models, fail-closed ops).
//   3. mcp_workspace_get_redteam_methodology — read REDTEAM (8D adversarial matrix).
//   4. mcp_workspace_get_workflow_protocol — read WORKFLOW (branching, merge, release).
//   5. mcp_workspace_get_em_swarm — read STRUCTURE_EM (E-M multi-agent topology).
//   6. mcp_workspace_get_milestone_status — read ROADMAP + SHIPPED merged (status + completed).

import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";
import "engine/tool/mcp_tool_dispatch.oo";

pub fn mcp_workspace_get_northstar(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    return mcp_workspace_read_board("NORTHSTAR", codex_text, g, s, fs);
}

pub fn mcp_workspace_get_security_threat_model(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    return mcp_workspace_read_board("SECURITY", codex_text, g, s, fs);
}

pub fn mcp_workspace_get_redteam_methodology(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    return mcp_workspace_read_board("REDTEAM", codex_text, g, s, fs);
}

pub fn mcp_workspace_get_workflow_protocol(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    return mcp_workspace_read_board("WORKFLOW", codex_text, g, s, fs);
}

pub fn mcp_workspace_get_em_swarm(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    return mcp_workspace_read_board("STRUCTURE_EM", codex_text, g, s, fs);
}

pub fn mcp_workspace_get_milestone_status(codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    let r1: String = mcp_workspace_read_board("ROADMAP", codex_text, g, s, fs);
    let r2: String = mcp_workspace_read_board("SHIPPED", codex_text, g, s, fs);
    return "{\"roadmap\":" + r1 + ",\"shipped\":" + r2 + "}";
}

fn mcp_workspace_read_board(name: String, codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    let args: String = "{\"name\":\"" + name + "\"}";
    return mcp_tool_dispatch("read_board", args, codex_text, g, s, fs);
}
