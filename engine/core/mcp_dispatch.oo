// # MCP Observe/Orient/Decide Dispatcher
//
// Logline: Extract params, audit phase and caps, and refuse illegal methods fail-closed.
//
// Setup: Act bodies for resources, prompts, and pong live here. Tool catalog lives in mcp_tool.oo.
//
// Beats:
//   1. Orient extracts uri, tool name, raw arguments object, prompt name.
//   2. Decide checks session, tier, and per-tool caps. Cancel is per id in mcp_server.oo.
//   3. Act builds resource, prompt, and pong envelopes.

import "engine/core/mcp_json.oo";
import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";
import "engine/tool/mcp_tool.oo";

pub type McpOrient = struct {
    uri: String,
    tool_name: String,
    tool_args: String,
    prompt_name: String,
    cancelled_id: String,
    if_none_match: String,
    root_uri: String,
    extracted: Bool
};

pub fn mcp_orient_empty() -> McpOrient {
    return McpOrient { uri: "", tool_name: "", tool_args: "{}", prompt_name: "", cancelled_id: "", if_none_match: "", root_uri: "", extracted: false };
}

pub fn mcp_dispatch_orient(method: String, params: String) -> McpOrient {
    let mut o: McpOrient = mcp_orient_empty();
    if method == "resources/read" {
        o.uri = mcp_json_extract_string(params, "uri");
        o.if_none_match = mcp_json_extract_string(params, "ifNoneMatch");
        if chars_len(o.uri) > 0 { o.extracted = true; }
        return o;
    }
    if method == "roots/list" {
        o.root_uri = mcp_json_extract_string(params, "uri");
        o.extracted = true;
        return o;
    }
    if method == "tools/call" {
        o.tool_name = mcp_json_extract_string(params, "name");
        let args: String = mcp_json_extract_raw(params, "arguments");
        o.tool_args = if chars_len(args) == 0 { "{}" } else { args };
        if chars_len(o.tool_name) > 0 { o.extracted = true; }
        return o;
    }
    if method == "prompts/get" {
        o.prompt_name = mcp_json_extract_string(params, "name");
        if chars_len(o.prompt_name) > 0 { o.extracted = true; }
        return o;
    }
    if method == "notifications/cancelled" {
        o.cancelled_id = mcp_json_extract_raw(params, "requestId");
        o.extracted = true;
        return o;
    }
    return o;
}

pub fn mcp_dispatch_decide(s: &McpSession, g: &McpGraph, method: String, orient: &McpOrient) -> Int {
    if !mcp_session_allows(s, method) { return 0 - 32600; }
    if !mcp_session_tier_allows(s.tier, method) { return 0 - 32604; }
    if method == "resources/read" {
        if chars_len(orient.uri) == 0 { return 0 - 32602; }
        if !mcp_orient_uri_is_canonical(orient.uri) { return 0 - 32602; }
        return 0;
    }
    if method == "tools/call" {
        if !orient.extracted { return 0 - 32602; }
        let req: Int = mcp_tool_required_caps(g, orient.tool_name);
        if req < 0 { return 0 - 32601; }
        if req == 0 { return 0; }
        if (req & s.caps_held) != req { return 0 - 32603; }
        return 0;
    }
    if method == "prompts/get" {
        if orient.prompt_name == "orientation" { return 0; }
        return 0 - 32601;
    }
    return 0;
}

pub fn mcp_orient_uri_is_canonical(uri: String) -> Bool {
    if uri == "ooda://orientation" { return true; }
    if uri == "ooda://orientation/graph" { return true; }
    if uri == "ooda://orientation/header" { return true; }
    if uri == "ooda://orientation/boards" { return true; }
    if uri == "ooda://orientation/capabilities" { return true; }
    if uri == "ooda://orientation/redteam" { return true; }
    if uri == "ooda://em/metrics" { return true; }
    return false;
}

pub fn mcp_dispatch_ok(id: String, body: String) -> String { return mcp_json_ok(id, body); }
pub fn mcp_dispatch_err(id: String, code: Int, msg: String) -> String { return mcp_json_err(id, code, msg); }
pub fn mcp_dispatch_err_tier(id: String, tier: Int, method: String) -> String {
    return mcp_json_err(id, 0 - 32604, "Tier " + tier.to_string() + " does not allow method: " + method);
}

pub fn mcp_dispatch_pong(id: String, s: &McpSession) -> String {
    let body: String = "{\"pong\":true,\"phase\":" + s.phase.to_string() + ",\"tier\":" + s.tier.to_string() + ",\"request_seq\":" + s.request_seq.to_string() + ",\"caps_held\":" + s.caps_held.to_string() + ",\"bytes_in\":" + s.bytes_in.to_string() + ",\"bytes_out\":" + s.bytes_out.to_string() + ",\"protocol\":\"" + s.served_protocol + "\"}";
    return mcp_json_ok(id, body);
}

pub fn mcp_dispatch_act_capabilities(codex_version: String, server_version: String) -> String {
    return "{\"protocolVersion\":\"" + mcp_wire_protocol_version() + "\",\"capabilities\":{\"resources\":{},\"tools\":{},\"prompts\":{}},\"serverInfo\":{\"name\":\"openOODA MCP Server\",\"version\":\"" + server_version + "\",\"codexVersion\":\"" + codex_version + "\"}}";
}

pub fn mcp_dispatch_codex_version(sha: String) -> String {
    if chars_len(sha) < 8 { return "unverified"; }
    return str_slice(sha, 0, 8);
}

pub fn mcp_dispatch_not_modified(id: String) -> String {
    return mcp_json_err(id, 0 - 32606, "Not modified");
}

pub fn mcp_dispatch_etag_matches(etag: String, sha: String) -> Bool {
    if chars_len(etag) == 0 { return false; }
    if chars_len(sha) < 8 { return false; }
    return etag == str_slice(sha, 0, 8);
}

pub fn mcp_dispatch_act_resource_read(uri: String, codex_text: String, g: &McpGraph) -> String {
    let u: String = mcp_json_escape(uri);
    if uri == "ooda://orientation/graph" {
        return "{\"uri\":\"" + u + "\",\"mimeType\":\"application/vnd.ooda.graph+json\",\"text\":\"" + mcp_json_escape(mcp_graph_to_json(g)) + "\"}";
    }
    if uri == "ooda://orientation/header" {
        return "{\"uri\":\"" + u + "\",\"mimeType\":\"application/vnd.ooda.header+json\",\"text\":\"" + mcp_json_escape("{\"version\":\"" + g.version + "\",\"protocol\":\"" + g.protocol + "\"}") + "\"}";
    }
    if uri == "ooda://orientation/boards" {
        return "{\"uri\":\"" + u + "\",\"mimeType\":\"application/vnd.ooda.boards+json\",\"text\":\"" + mcp_json_escape(mcp_dispatch_act_boards_json(g)) + "\"}";
    }
    if uri == "ooda://orientation/capabilities" {
        return "{\"uri\":\"" + u + "\",\"mimeType\":\"application/vnd.ooda.caps+json\",\"text\":\"" + mcp_json_escape(mcp_dispatch_act_caps_json(g)) + "\"}";
    }
    if uri == "ooda://orientation/redteam" {
        return "{\"uri\":\"" + u + "\",\"mimeType\":\"application/vnd.ooda.redteam+json\",\"text\":\"" + mcp_json_escape(mcp_dispatch_act_gates_json(g)) + "\"}";
    }
    return "{\"uri\":\"" + u + "\",\"mimeType\":\"text/x-ooda-tree\",\"text\":\"" + mcp_json_escape(codex_text) + "\"}";
}

fn mcp_dispatch_act_caps_json(g: &McpGraph) -> String {
    let mut out: String = "[";
    let n: Int = list_len(g.capabilities);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + ","; }
        let c: McpCapability = list_get(g.capabilities, i);
        out = out + "{\"token\":\"" + c.token + "\",\"kind\":\"" + c.kind + "\"}";
        i = i + 1;
    }
    return out + "]";
}

fn mcp_dispatch_act_boards_json(g: &McpGraph) -> String {
    let mut out: String = "[";
    let n: Int = list_len(g.boards);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + ","; }
        let b: McpBoard = list_get(g.boards, i);
        out = out + "{\"name\":\"" + b.name + "\",\"path\":\"" + b.path + "\"}";
        i = i + 1;
    }
    return out + "]";
}

fn mcp_dispatch_act_gates_json(g: &McpGraph) -> String {
    let mut out: String = "[";
    let n: Int = list_len(g.redteam_gates);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { out = out + ","; }
        let gt: McpRedteamGate = list_get(g.redteam_gates, i);
        out = out + "{\"axis\":\"" + gt.axis + "\",\"dimension\":" + gt.dimension.to_string() + "}";
        i = i + 1;
    }
    return out + "]";
}

pub fn mcp_dispatch_act_prompts_list() -> String {
    return "{\"prompts\":[{\"name\":\"orientation\",\"description\":\"openOODA agent orientation\",\"arguments\":[]}]}";
}

pub fn mcp_dispatch_act_prompt_get(name: String) -> String {
    if name != "orientation" { return ""; }
    return "{\"description\":\"openOODA agent orientation\",\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":\"Read ANCHOR.oo, RULES.oot, NORTHSTAR.oot, then rfcs/ and practices/. Honor 14 capability tokens. Submit to 8 redteam gates.\"}}]}";
}

pub fn mcp_dispatch_required_caps(method: String) -> Int {
    if method == "resources/read" { return 1; }
    return 0;
}

pub fn mcp_dispatch_cap_audit(method: String, caps_held: Int) -> Int {
    let req: Int = mcp_dispatch_required_caps(method);
    if req == 0 { return 0; }
    if (req & caps_held) != req { return 0 - 32603; }
    return 0;
}

pub fn mcp_dispatch_act_resources_list() -> String {
    return "{\"resources\":[{\"uri\":\"ooda://orientation\",\"name\":\"Orientation Codex\",\"mimeType\":\"text/x-ooda-tree\"},{\"uri\":\"ooda://orientation/graph\",\"name\":\"Capability Graph\",\"mimeType\":\"application/vnd.ooda.graph+json\"},{\"uri\":\"ooda://orientation/header\",\"name\":\"Header\",\"mimeType\":\"application/vnd.ooda.header+json\"},{\"uri\":\"ooda://orientation/boards\",\"name\":\"Governance Boards\",\"mimeType\":\"application/vnd.ooda.boards+json\"},{\"uri\":\"ooda://orientation/capabilities\",\"name\":\"Capability Tokens\",\"mimeType\":\"application/vnd.ooda.caps+json\"},{\"uri\":\"ooda://orientation/redteam\",\"name\":\"Redteam Gates\",\"mimeType\":\"application/vnd.ooda.redteam+json\"},{\"uri\":\"ooda://em/metrics\",\"name\":\"E-M Metrics\",\"mimeType\":\"application/vnd.ooda.em+json\"}]}";
}
