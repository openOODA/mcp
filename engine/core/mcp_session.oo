// # MCP Session State Machine
//
// Logline: Track per-host MCP session lifecycle, replay ids, per-id cancel, and rate window.
//
// Setup: Zero-ambient state owned by the transport. Every transition is explicit.
//
// Beats:
//   1. Construct a fresh session in AwaitingInitialize with zero cap bits.
//   2. Advance on initialize to Negotiating, then Ready on notifications/initialized.
//   3. Fail-closed: pre-init tools/call returns -32600.
//   4. seen_ids rejects duplicates. cancelled_ids is per request id, cap 256.
//   5. Rate window: 100 requests per 1000 seq.

import "engine/health/mcp_audit.oo";
import "engine/core/mcp_json.oo";
import "engine/state/mcp_graph.oo";

pub fn mcp_phase_await() -> Int { return 0; }
pub fn mcp_phase_negot() -> Int { return 1; }
pub fn mcp_phase_ready() -> Int { return 2; }
pub fn mcp_phase_down()  -> Int { return 3; }
pub fn mcp_phase_closed() -> Int { return 4; }

pub fn mcp_tier_minimal() -> Int { return 0; }
pub fn mcp_tier_full()    -> Int { return 1; }
pub fn mcp_tier_audit()   -> Int { return 2; }

pub type McpSession = struct {
    phase: Int,
    tier: Int,
    client_name: String,
    client_version: String,
    requested_protocol: String,
    served_protocol: String,
    request_seq: Int,
    bytes_in: Int,
    bytes_out: Int,
    seen_ids: List[String],
    client_roots: List[String],
    caps_held: Int,
    cancelled_ids: List[String],
    pending_roots_id: String,
    server_req_seq: Int,
    pending_notifications: List[String],
    rate_window_start: Int,
    rate_window_count: Int,
    audit_log: List[McpAuditEntry],
    audit_chain_head: String,
    ooda_phase: Int,
    token_prompt_tokens: Int,
    token_tool_payload_bytes: Int,
    token_calls: Int
};

pub fn mcp_session_new() -> McpSession {
    return McpSession {
        phase: mcp_phase_await(),
        tier: mcp_tier_full(),
        client_name: "",
        client_version: "",
        requested_protocol: "",
        served_protocol: mcp_wire_protocol_version(),
        request_seq: 0,
        bytes_in: 0,
        bytes_out: 0,
        seen_ids: list_new(),
        client_roots: list_new(),
        caps_held: 0,
        cancelled_ids: list_new(),
        pending_roots_id: "",
        server_req_seq: 0,
        pending_notifications: list_new(),
        rate_window_start: 0,
        rate_window_count: 0,
        audit_log: list_new(),
        audit_chain_head: "",
        ooda_phase: 0,
        token_prompt_tokens: 0,
        token_tool_payload_bytes: 0,
        token_calls: 0
    };
}

pub fn mcp_session_grant_cap(s: &mut McpSession, bit: Int) {
    s.caps_held = s.caps_held | bit;
}

pub fn mcp_session_tier_allows(tier: Int, method: String) -> Bool {
    if method == "initialize" { return true; }
    if method == "ping" { return true; }
    if method == "shutdown" { return true; }
    if method == "exit" { return true; }
    if method == "notifications/initialized" { return true; }
    if method == "notifications/cancelled" { return true; }
    if method == "notifications/roots/list_changed" { return true; }
    if tier == mcp_tier_minimal() { return false; }
    if method == "resources/list" { return true; }
    if method == "tools/list" { return true; }
    if method == "prompts/list" { return true; }
    if method == "resources/read" { return true; }
    if method == "tools/call" { return true; }
    if method == "prompts/get" { return true; }
    if method == "roots/list" { return true; }
    if method == "redteam/probe" { return false; }
    if tier == mcp_tier_audit() { return true; }
    return true;
}

pub fn mcp_session_set_tier(s: &mut McpSession, tier: Int) -> Int {
    if tier < 0 { return 0 - 32602; }
    if tier > 2 { return 0 - 32602; }
    s.tier = tier;
    return 0;
}

pub fn mcp_session_add_root(s: &mut McpSession, root: String) {
    if chars_len(root) == 0 { return; }
    s.client_roots = list_push(s.client_roots, root);
}

fn mcp_session_list_has(xs: List[String], id: String) -> Bool {
    let n: Int = list_len(xs);
    let mut i: Int = 0;
    while i < n {
        if list_get(xs, i) == id { return true; }
        i = i + 1;
    }
    return false;
}

fn mcp_session_push_capped(xs: List[String], v: String) -> List[String] {
    let n: Int = list_len(xs);
    if n < 256 { return list_push(xs, v); }
    let mut nxt: List[String] = list_new();
    let mut j: Int = 1;
    while j < n {
        nxt = list_push(nxt, list_get(xs, j));
        j = j + 1;
    }
    return list_push(nxt, v);
}

pub fn mcp_session_cancel_id(s: &mut McpSession, id: String) {
    if chars_len(id) == 0 { return; }
    if mcp_session_list_has(s.cancelled_ids, id) { return; }
    s.cancelled_ids = mcp_session_push_capped(s.cancelled_ids, id);
}

pub fn mcp_session_id_cancelled(s: &McpSession, id: String) -> Bool {
    if chars_len(id) == 0 { return false; }
    return mcp_session_list_has(s.cancelled_ids, id);
}

pub fn mcp_session_next_server_id(s: &mut McpSession) -> String {
    s.server_req_seq = s.server_req_seq + 1;
    return "\"mcp-roots-" + s.server_req_seq.to_string() + "\"";
}

pub fn mcp_session_allows(s: &McpSession, method: String) -> Bool {
    if s.phase == mcp_phase_closed() { return method == "exit"; }
    if s.phase == mcp_phase_down() { return method == "exit"; }
    if method == "initialize" { return true; }
    if method == "notifications/cancelled" { return true; }
    if s.phase == mcp_phase_ready() { return true; }
    if method == "ping" { return false; }
    return false;
}

pub fn mcp_session_on_initialize(s: &mut McpSession, client_name: String, client_version: String, requested_protocol: String) -> Int {
    if s.phase != mcp_phase_await() { return s.phase; }
    s.client_name = client_name;
    s.client_version = client_version;
    s.requested_protocol = requested_protocol;
    s.phase = mcp_phase_negot();
    return s.phase;
}

pub fn mcp_session_on_initialized(s: &mut McpSession) -> Int {
    if s.phase == mcp_phase_negot() { s.phase = mcp_phase_ready(); }
    return s.phase;
}

pub fn mcp_session_on_shutdown(s: &mut McpSession) -> Int {
    if s.phase == mcp_phase_closed() { return s.phase; }
    s.phase = mcp_phase_down();
    return s.phase;
}

pub fn mcp_session_on_close(s: &mut McpSession) -> Int {
    if s.phase == mcp_phase_closed() { return s.phase; }
    s.phase = mcp_phase_closed();
    return s.phase;
}

pub fn mcp_session_error_not_initialized(id: String) -> String {
    return mcp_json_err(id, 0 - 32600, "Server not initialized");
}

pub fn mcp_session_error_duplicate_id(id: String) -> String {
    return mcp_json_err(id, 0 - 32603, "Duplicate request id: replay blocked");
}

pub fn mcp_session_next_seq(s: &mut McpSession) -> Int {
    s.request_seq = s.request_seq + 1;
    return s.request_seq;
}

pub fn mcp_session_accrue_in(s: &mut McpSession, n: Int) -> Int {
    s.bytes_in = s.bytes_in + n;
    return s.bytes_in;
}

pub fn mcp_session_accrue_out(s: &mut McpSession, n: Int) -> Int {
    s.bytes_out = s.bytes_out + n;
    return s.bytes_out;
}

pub fn mcp_session_seen_id(s: &mut McpSession, id: String) -> Bool {
    if chars_len(id) == 0 { return false; }
    if mcp_session_list_has(s.seen_ids, id) { return true; }
    s.seen_ids = mcp_session_push_capped(s.seen_ids, id);
    return false;
}

pub fn mcp_session_check_rate(s: &mut McpSession, max_per_window: Int, window: Int) -> Bool {
    if max_per_window <= 0 { return true; }
    if s.request_seq - s.rate_window_start >= window {
        s.rate_window_start = s.request_seq;
        s.rate_window_count = 0;
    }
    if s.rate_window_count >= max_per_window { return false; }
    s.rate_window_count = s.rate_window_count + 1;
    return true;
}
