// # MCP Server Core Loop
//
// Logline: Dispatch one JSON-RPC body. File transport runs a bounded buffer. Live stdio is mcp_stdio.oo.
//
// Setup: OODACODEX is required. protocolVersion must be 2024-11-05. Cancel is per request id.
//
// Beats:
//   1. Handle initialize, tools, resources, prompts, ping, shutdown, roots.
//   2. File mode fails closed at 256 frames or 1MiB and persists the audit log.
//   3. Live stdio is mcp_stdio.oo. Cancel is per request id.

import "engine/core/mcp_json.oo";
import "engine/core/mcp_session.oo";
import "engine/core/mcp_dispatch.oo";
import "engine/federation/mcp_codex.oo";
import "engine/core/mcp_transport.oo";
import "engine/state/mcp_roots.oo";
import "engine/state/mcp_notification.oo";
import "engine/core/mcp_batch.oo";
import "engine/state/mcp_em.oo";
import "engine/health/mcp_audit.oo";
import "engine/tool/mcp_tool_dispatch.oo";
import "engine/tool/mcp_tool.oo";
import "engine/tool/mcp_tool_token.oo";
import "engine/resource/mcp_schema.oo";
import "engine/state/mcp_ooda_state.oo";
import "engine/state/mcp_graph.oo";
import "engine/state/mcp_cap.oo";

pub fn mcp_server_handle_body(fs: &FsReadCap, s: &mut McpSession, g: &McpGraph, codex_text: String, body: String) -> String {
    let caps_before: Int = s.caps_held;
    mcp_session_accrue_in(s, bytes_len(body));
    let method: String = mcp_json_extract_method(body);
    let id: String = mcp_json_extract_id(body);
    let params: String = mcp_json_extract_params(body);
    mcp_session_next_seq(s);
    if method == "" {
        if chars_len(s.pending_roots_id) > 0 && id == s.pending_roots_id {
            mcp_roots_apply_result(s, mcp_json_extract_raw(body, "result"));
            s.pending_roots_id = "";
            return "";
        }
        return mcp_dispatch_err(id, 0 - 32600, "empty method");
    }
    if mcp_session_seen_id(s, id) { return mcp_session_error_duplicate_id(id); }
    let sha: String = g.substrate.gold_master_sha256;

    if chars_len(id) > 0 && !mcp_session_check_rate(s, 100, 1000) {
        return mcp_dispatch_err(id, 0 - 32607, "Rate limit: 100 req per 1000 req_seq");
    }
    if mcp_session_id_cancelled(s, id) {
        return mcp_dispatch_err(id, 0 - 32603, "Request cancelled: " + id);
    }

    let orient: McpOrient = mcp_dispatch_orient(method, params);
    s.ooda_phase = mcp_ooda_state_orient();

    if method == "initialize" {
        if s.phase != mcp_phase_await() {
            return mcp_dispatch_err(id, 0 - 32600, "already initialized");
        }
        let info: String = mcp_json_extract_raw(params, "clientInfo");
        let client_name: String = mcp_json_extract_string(info, "name");
        let client_ver: String = mcp_json_extract_string(info, "version");
        let req_proto: String = mcp_json_extract_string(params, "protocolVersion");
        if req_proto != mcp_wire_protocol_version() {
            return mcp_dispatch_err(id, 0 - 32600, "unsupported protocolVersion");
        }
        let tier_str: String = mcp_json_extract_string(params, "tier");
        let tier: Int = if tier_str == "minimal" { 0 } else if tier_str == "audit" { 2 } else { 1 };
        mcp_session_on_initialize(s, client_name, client_ver, req_proto);
        let tier_rc: Int = mcp_session_set_tier(s, tier);
        if tier_rc != 0 { return mcp_dispatch_err(id, tier_rc, "Invalid tier"); }
        mcp_session_grant_cap(s, mcp_cap_fs_read_bit());
        return mcp_dispatch_ok(id, mcp_dispatch_act_capabilities(mcp_dispatch_codex_version(sha), g.version));
    }
    if method == "notifications/initialized" {
        mcp_session_on_initialized(s);
        return "";
    }
    if method == "shutdown" {
        mcp_session_on_shutdown(s);
        return mcp_dispatch_ok(id, "null");
    }
    if method == "exit" {
        mcp_session_on_close(s);
        return "";
    }
    if method == "notifications/cancelled" {
        mcp_session_cancel_id(s, orient.cancelled_id);
        return "";
    }
    if method == "notifications/roots/list_changed" {
        if s.phase != mcp_phase_negot() && s.phase != mcp_phase_ready() { return ""; }
        let rid: String = mcp_session_next_server_id(s);
        s.pending_roots_id = rid;
        return mcp_roots_list_request(rid);
    }

    let decision: Int = mcp_dispatch_decide(s, g, method, &orient);
    if decision != 0 {
        if decision == 0 - 32600 { return mcp_session_error_not_initialized(id); }
        if decision == 0 - 32601 {
            let what: String = if method == "tools/call" { orient.tool_name } else { method };
            return mcp_dispatch_err(id, 0 - 32601, "Method not found: " + what);
        }
        if decision == 0 - 32602 { return mcp_dispatch_err(id, 0 - 32602, "Invalid params: " + method); }
        if decision == 0 - 32604 { return mcp_dispatch_err_tier(id, s.tier, method); }
        return mcp_dispatch_err(id, decision, "Refused: " + method);
    }
    let cap_check: Int = mcp_dispatch_cap_audit(method, s.caps_held);
    if cap_check == 0 - 32603 {
        return mcp_dispatch_err(id, 0 - 32603, "missing required capability token for " + method);
    }

    let mut response: String = "";
    if method == "ping" {
        response = mcp_dispatch_pong(id, s);
    } else if method == "resources/list" {
        response = mcp_dispatch_ok(id, mcp_dispatch_act_resources_list());
    } else if method == "resources/read" {
        if chars_len(orient.if_none_match) > 0 && mcp_dispatch_etag_matches(orient.if_none_match, sha) {
            response = mcp_dispatch_not_modified(id);
        } else if !mcp_root_allows(s, orient.uri) {
            response = mcp_dispatch_err(id, 0 - 32605, "URI outside declared client roots: " + orient.uri);
        } else if orient.uri == "ooda://em/metrics" {
            if s.tier != mcp_tier_audit() {
                response = mcp_dispatch_err(id, 0 - 32604, "Tier denies ooda://em/metrics");
            } else {
                response = mcp_dispatch_ok(id, "{\"contents\":[{\"uri\":\"ooda://em/metrics\",\"mimeType\":\"application/vnd.ooda.em+json\",\"text\":\"" + mcp_json_escape(mcp_em_snapshot(s, g)) + "\"}]}");
            }
        } else {
            let block: String = mcp_dispatch_act_resource_read(orient.uri, codex_text, g);
            response = mcp_dispatch_ok(id, "{\"contents\":[" + block + "]}");
        }
    } else if method == "roots/list" {
        response = mcp_server_roots_json(id, s);
    } else if method == "tools/list" {
        response = mcp_dispatch_ok(id, mcp_tool_list_json(g));
    } else if method == "tools/call" {
        s.ooda_phase = mcp_ooda_state_decide();
        let reval: String = mcp_revalidate_and_queue_caps(s, g);
        if chars_len(reval) > 0 { return mcp_dispatch_err(id, 0 - 32603, "Cap revoked between audit and act"); }
        if mcp_schema_validate(orient.tool_name, orient.tool_args) != 0 {
            response = mcp_dispatch_err(id, 0 - 32602, "schema invalid for tool: " + orient.tool_name);
        } else {
            s.ooda_phase = mcp_ooda_state_act();
            mcp_token_record(s, orient.tool_name, orient.tool_args);
            let body_str: String = mcp_tool_dispatch(orient.tool_name, orient.tool_args, codex_text, g, s, fs);
            s.ooda_phase = mcp_ooda_state_idle();
            response = mcp_dispatch_ok(id, body_str);
        }
    } else if method == "prompts/list" {
        response = mcp_dispatch_ok(id, mcp_dispatch_act_prompts_list());
    } else if method == "prompts/get" {
        let p: String = mcp_dispatch_act_prompt_get(orient.prompt_name);
        if chars_len(p) == 0 { response = mcp_dispatch_err(id, 0 - 32601, "Unknown prompt: " + orient.prompt_name); }
        else { response = mcp_dispatch_ok(id, p); }
    } else {
        response = mcp_dispatch_err(id, 0 - 32601, "Method not found: " + method);
    }
    mcp_session_accrue_out(s, bytes_len(response));
    response = mcp_drain_into_response(s, body, response);
    let audit_code: Int = if mcp_json_has_error(response) { 0 - 32603 } else { 0 };
    let _: String = mcp_audit_record(s, s.request_seq, method, id, 0, audit_code, caps_before, s.caps_held, "");
    return response;
}

fn mcp_server_roots_json(id: String, s: &McpSession) -> String {
    let roots: List[String] = s.client_roots;
    let mut body: String = "{\"roots\":[";
    let n: Int = list_len(roots);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { body = body + ","; }
        body = body + "{\"uri\":\"" + mcp_json_escape(list_get(roots, i)) + "\"}";
        i = i + 1;
    }
    body = body + "]}";
    return mcp_dispatch_ok(id, body);
}

pub fn mcp_server_handle_batch(fs: &FsReadCap, s: &mut McpSession, g: &McpGraph, codex_text: String, body: String) -> String {
    let items: List[String] = mcp_batch_split(body);
    let mut responses: List[String] = list_new();
    let n: Int = list_len(items);
    let mut i: Int = 0;
    while i < n {
        let item: String = list_get(items, i);
        let resp: String = mcp_server_handle_body(fs, s, g, codex_text, item);
        if chars_len(resp) > 0 {
            responses = list_push(responses, resp);
        }
        i = i + 1;
    }
    return mcp_batch_collect(responses);
}

pub fn mcp_server_run(fw: &FsWriteCap, fs: &FsReadCap, env: &EnvCap, t: &McpTransport) -> Result[String, String] {
    if t.kind == mcp_transport_kind_stdio() { return Err("stdio uses mcp_stdio_serve"); }
    let raw: String = match mcp_transport_read(fs, t) { Ok(s) => s, Err(e) => return Err(e); };
    if chars_len(raw) == 0 { return Err("empty input"); }
    let mut cache: McpCodexCache = mcp_codex_cache_new();
    let cached: Int = mcp_codex_resolve_cached(fs, env, &mut cache);
    if cached == 0 { return Err("OODACODEX missing or unreadable"); }
    let mut session: McpSession = mcp_session_new();
    let mut buf: String = raw;
    let mut out: String = "";
    let mut frames: Int = 0;
    while true {
        let fr: McpFrame = mcp_transport_take(buf);
        if !mcp_frame_is_ok(&fr) { break; }
        let rest: String = mcp_frame_rest(&fr);
        let body: String = mcp_frame_body(&fr);
        if rest == buf { break; }
        buf = rest;
        if chars_len(body) == 0 { continue; }
        frames = frames + 1;
        if frames > 256 {
            let _: Int = mcp_audit_persist(fw, &session);
            return Err("frame cap 256");
        }
        let resp: String = if mcp_batch_is_batch(body) { mcp_server_handle_batch(fs, &mut session, &cache.graph, cache.text, body) } else { mcp_server_handle_body(fs, &mut session, &cache.graph, cache.text, body) };
        if chars_len(resp) > 0 {
            let framed: String = mcp_transport_emit(raw, resp);
            if bytes_len(resp) > 1048576 || bytes_len(out) + bytes_len(framed) > 1048576 {
                let _: Int = mcp_audit_persist(fw, &session);
                return Err("response exceeds 1MiB");
            }
            out = out + framed;
        }
        if session.phase == mcp_phase_closed() || session.phase == mcp_phase_down() { break; }
    }
    let _: Int = mcp_audit_persist(fw, &session);
    return Ok(out);
}
