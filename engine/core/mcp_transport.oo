// # MCP Transport
//
// Logline: Read bytes from stdio or one file, then take Content-Length or raw JSON frames.
//
// Setup: Two transports. Socket is absent: a file read is not a socket.
//
// Beats:
//   1. Stdio reads stdin once.
//   2. File reads one path under FsReadCap.
//   3. Take one frame: Content-Length or a top-level JSON object.
//   4. Emit Content-Length when the input used it.

import "engine/core/mcp_json.oo";

pub type McpFrame = struct {
    ok: Bool,
    body: String,
    rest: String
};

pub fn mcp_frame_none() -> McpFrame {
    return McpFrame { ok: false, body: "", rest: "" };
}

pub fn mcp_frame_take(body: String, rest: String) -> McpFrame {
    return McpFrame { ok: true, body: body, rest: rest };
}

pub fn mcp_frame_is_ok(fr: &McpFrame) -> Bool { return fr.ok; }
pub fn mcp_frame_body(fr: &McpFrame) -> String { return fr.body; }
pub fn mcp_frame_rest(fr: &McpFrame) -> String { return fr.rest; }

pub fn mcp_transport_kind_stdio() -> Int { return 0; }
pub fn mcp_transport_kind_file()  -> Int { return 1; }

pub type McpTransport = struct {
    kind: Int,
    file_path: String
};

pub fn mcp_transport_stdio() -> McpTransport {
    return McpTransport { kind: mcp_transport_kind_stdio(), file_path: "" };
}

pub fn mcp_transport_file(path: String) -> McpTransport {
    return McpTransport { kind: mcp_transport_kind_file(), file_path: path };
}

pub fn mcp_transport_read(fs: &FsReadCap, t: &McpTransport) -> Result[String, String] {
    if t.kind == mcp_transport_kind_stdio() {
        return Ok(oo_read_stdin());
    }
    if t.kind == mcp_transport_kind_file() {
        if !path_exists(fs, t.file_path) { return Err("FILE_NOT_FOUND"); }
        return read_file(fs, t.file_path);
    }
    return Err("UNKNOWN_TRANSPORT");
}

fn mcp_skip_ws(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1; } else { return i; }
    }
    return i;
}

fn mcp_take_json_object(s: String) -> McpFrame {
    let n: Int = chars_len(s);
    if n == 0 || char_at(s, 0) != "{" { return mcp_frame_none(); }
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
        } else if c == "\"" { in_str = true; }
        else if c == "{" { depth = depth + 1; }
        else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return mcp_frame_take(str_slice(s, 0, i + 1), str_slice(s, i + 1, n));
            }
        }
        i = i + 1;
    }
    return mcp_frame_none();
}

pub fn mcp_transport_take(buf: String) -> McpFrame {
    let n: Int = chars_len(buf);
    let i: Int = mcp_skip_ws(buf);
    if i >= n { return mcp_frame_none(); }
    let tail: String = str_slice(buf, i, n);
    if str_starts_with(tail, "Content-Length:") {
        let clen: Int = mcp_json_content_length(tail);
        let crlf: Int = str_index_of(tail, "\r\n\r\n");
        let lf: Int = str_index_of(tail, "\n\n");
        let mut sep: Int = 0 - 1;
        let mut sepn: Int = 0;
        if crlf >= 0 { sep = crlf; sepn = 4; }
        if lf >= 0 && (sep < 0 || lf < sep) { sep = lf; sepn = 2; }
        if sep < 0 || clen < 1 { return mcp_frame_none(); }
        let start: Int = sep + sepn;
        let tlen: Int = chars_len(tail);
        if start + clen > tlen { return mcp_frame_none(); }
        return mcp_frame_take(str_slice(tail, start, start + clen), str_slice(tail, start + clen, tlen));
    }
    return mcp_take_json_object(tail);
}

pub fn mcp_transport_emit(raw_input: String, response: String) -> String {
    if str_starts_with(raw_input, "Content-Length:") {
        return mcp_json_frame(response);
    }
    return response + "\n";
}
