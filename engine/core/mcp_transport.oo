// # MCP Transport Abstraction
//
// Logline: Pluggable byte-stream transport for the MCP server: stdio and single-shot file batch.
//
// Setup: Transport is a tagged kind. Frame layout (LSP-style Content-Length OR raw JSON object) is shared with the LSP layer.
//
// Beats:
//   1. Define McpTransportKind enum as Int.
//   2. McpStdio: reads the full stdin chunk once and processes.
//   3. McpFile: reads a single file path, dispatches, and exits (one-shot).
//
// ## CAPs
//   &FsReadCap: Read a batch file for the file transport.

import "lsp/types/lsp_types.oo";
import "lsp/wire/lsp_jsonrpc.oo";

pub fn mcp_transport_kind_stdio()  -> Int { return 0; }
pub fn mcp_transport_kind_file()   -> Int { return 1; }
pub fn mcp_transport_kind_socket() -> Int { return 2; }

type McpTransport = struct {
    kind: Int,
    file_path: String
};

pub fn mcp_transport_stdio() -> McpTransport {
    return McpTransport { kind: mcp_transport_kind_stdio(), file_path: "" };
}

pub fn mcp_transport_file(path: String) -> McpTransport {
    return McpTransport { kind: mcp_transport_kind_file(), file_path: path };
}

pub fn mcp_transport_socket(path: String) -> McpTransport {
    return McpTransport { kind: mcp_transport_kind_socket(), file_path: path };
}

// Pull the raw input bytes for the given transport. File/Socket via FsReadCap, no fallback.
pub fn mcp_transport_read(fs: &FsReadCap, t: &McpTransport) -> Result[String, String] {
    if t.kind == mcp_transport_kind_stdio() {
        let raw: String = oo_read_stdin();
        return Ok(raw);
    }
    if t.kind == mcp_transport_kind_file() {
        if !path_exists(fs, t.file_path) { return Err("FILE_NOT_FOUND"); }
        return read_file(fs, t.file_path);
    }
    if t.kind == mcp_transport_kind_socket() {
        if !path_exists(fs, t.file_path) { return Err("SOCKET_NOT_FOUND"); }
        return read_file(fs, t.file_path);
    }
    return Err("UNKNOWN_TRANSPORT");
}

fn mcp_skip_ws(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" {
            i = i + 1;
        } else {
            return i;
        }
    }
    return i;
}

// Take one top-level JSON object from the head of `s`.
fn mcp_take_json_object(s: String) -> LspFrame {
    let n: Int = chars_len(s);
    if n == 0 || char_at(s, 0) != "{" {
        return lsp_frame_none();
    }
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if in_str {
            if esc { esc = false; }
            else if c == "\\" { esc = true; }
            else if c == "\"" { in_str = false; }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 {
                return lsp_frame_take(str_slice(s, 0, i + 1), str_slice(s, i + 1, n));
            }
        }
        i = i + 1;
    }
    return lsp_frame_none();
}

// Take one framed MCP message: either LSP-style Content-Length or a raw JSON object.
pub fn mcp_transport_take(buf: String) -> LspFrame {
    let n: Int = chars_len(buf);
    let i: Int = mcp_skip_ws(buf);
    if i >= n {
        return lsp_frame_none();
    }
    let tail: String = str_slice(buf, i, n);
    if str_starts_with(tail, "Content-Length:") {
        let clen: Int = lsp_jsonrpc_parse_content_length(tail);
        let crlf: Int = str_index_of(tail, "\r\n\r\n");
        let lf: Int = str_index_of(tail, "\n\n");
        let mut sep: Int = 0 - 1;
        let mut sepn: Int = 0;
        if crlf >= 0 { sep = crlf; sepn = 4; }
        if lf >= 0 && (sep < 0 || lf < sep) { sep = lf; sepn = 2; }
        if sep < 0 || clen < 1 { return lsp_frame_none(); }
        let start: Int = sep + sepn;
        let tlen: Int = chars_len(tail);
        if start + clen > tlen { return lsp_frame_none(); }
        return lsp_frame_take(str_slice(tail, start, start + clen), str_slice(tail, start + clen, tlen));
    }
    return mcp_take_json_object(tail);
}

// Emit a single response body. If the input started with a Content-Length header,
// frame the response LSP-style; else append a newline (raw-JSON stdio mode).
pub fn mcp_transport_emit(raw_input: String, response: String) -> String {
    if str_starts_with(raw_input, "Content-Length:") {
        return lsp_jsonrpc_frame(response);
    }
    return response + "\n";
}
