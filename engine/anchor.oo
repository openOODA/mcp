// # MCP Engine
//
// Logline: Front door for the MCP engine. Re-exports six subdirs: core, tool, health, federation, state, resource.
//
// Setup: Dispatch facade. Codex load is federation/mcp_codex.oo. No scheduler stub.
//
// Beats:
//   1. core: json, dispatch, server, stdio, session, transport, batch.
//   2. tool: catalog and dispatch for 27 tools.
//   3. health: audit log and 8D redteam fires.
//   4. federation: OODACODEX loader only.
//   5. state: graph, caps, session-adjacent telemetry.
//   6. resource: schema, format, context budget.

import "core/anchor.oo";
import "tool/anchor.oo";
import "health/anchor.oo";
import "federation/anchor.oo";
import "state/anchor.oo";
import "resource/anchor.oo";
