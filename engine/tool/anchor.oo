// # Mcp Tool Interface
//
// Logline: Tool catalog and tools/call dispatch for 26 typed tools.
//
// Setup: One catalog in mcp_tool.oo. Dispatch in mcp_tool_dispatch.oo. Token tools in mcp_tool_token.oo.
//        Exec tools in mcp_tool_exec.oo. Topic slice in mcp_tool_slice.oo.
//
// Beats:
//   1. mcp_tool.oo is the catalog, wrap, and board read.
//   2. mcp_tool_dispatch.oo routes by name.
//   3. mcp_tool_token.oo estimates and records LLM context tokens.
//   4. mcp_tool_exec.oo runs oodac check/emit/build under the operator ProcessCap.
//   5. mcp_tool_slice.oo slices rules.oot by topic.

import "mcp_tool.oo";
import "mcp_tool_dispatch.oo";
import "mcp_tool_token.oo";
import "mcp_tool_exec.oo";
import "mcp_tool_slice.oo";
