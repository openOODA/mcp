// # MCP Tool Dispatch
//
// Logline: Route tools/call to one of 22 typed tools and wrap the result. Unknown tool fails closed.
//
// Setup: Schema first. Board tools call mcp_tool_read_board. No health alias. No deleted-board tools.
//
// Beats:
//   1. Validate schema.
//   2. Dispatch the 22 names.
//   3. Unknown name returns an error object.

import "engine/core/mcp_json.oo";
import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";
import "engine/health/mcp_audit.oo";
import "engine/state/mcp_ooda_state.oo";
import "engine/resource/mcp_context_budget.oo";
import "engine/resource/mcp_format.oo";
import "engine/tool/mcp_tool.oo";
import "engine/tool/mcp_tool_token.oo";

pub fn mcp_tool_dispatch(name: String, args: String, codex_text: String, g: &McpGraph, s: &mut McpSession, fs: &FsReadCap) -> String {
    if name == "get_capability_graph" { return mcp_tool_wrap(mcp_graph_to_json(g)); }
    if name == "get_orientation" { return mcp_tool_wrap(codex_text); }
    if name == "read_board" { return mcp_tool_read_board(fs, g, mcp_tool_arg_string(args, "name", "")); }
    if name == "get_audit_log" { return mcp_tool_wrap(mcp_audit_tail(s, mcp_tool_arg_int(args, "tail", 10))); }
    if name == "get_board_index" { return mcp_tool_wrap(mcp_context_budget_get_board_index(g)); }
    if name == "summarize_board" {
        return mcp_tool_wrap(mcp_context_budget_summarize_board(fs, g, mcp_tool_arg_string(args, "name", ""), mcp_tool_arg_int(args, "max_chars", 2000)));
    }
    if name == "compress_orient" { return mcp_tool_wrap(mcp_context_budget_compress_orient(codex_text, mcp_tool_arg_int(args, "max_chars", 2000))); }
    if name == "get_context_budget" { return mcp_tool_wrap(mcp_context_budget_get_context(s)); }
    if name == "get_ooda_phase" { return mcp_tool_wrap(mcp_ooda_state_get_phase(s)); }
    if name == "get_decision_journal" { return mcp_tool_wrap(mcp_ooda_state_get_decision_journal(s, mcp_tool_arg_int(args, "n", 10))); }
    if name == "get_redteam_realtime" { return mcp_tool_wrap(mcp_ooda_state_get_redteam_realtime()); }
    if name == "get_session_diagnostics" { return mcp_tool_wrap(mcp_ooda_state_get_session_diagnostics(s, g)); }
    if name == "get_format_constraints" { return mcp_tool_wrap(mcp_format_get_constraints()); }
    if name == "validate_codex_format" { return mcp_tool_wrap(mcp_format_validate_codex(mcp_json_extract_string(args, "text"))); }
    if name == "get_northstar" { return mcp_tool_read_board(fs, g, "NORTHSTAR"); }
    if name == "get_rules" { return mcp_tool_read_board(fs, g, "RULES"); }
    if name == "get_rfc" { return mcp_tool_read_board(fs, g, mcp_tool_rfc_name(mcp_tool_arg_string(args, "name", ""))); }
    if name == "get_practice" { return mcp_tool_read_board(fs, g, mcp_tool_practice_name(mcp_tool_arg_string(args, "name", ""))); }
    if name == "audit_compact" {
        let keep: Int = mcp_tool_arg_int(args, "keep_last_n", 100);
        let dropped: Int = mcp_audit_compact(s, keep);
        return mcp_tool_wrap("{\"dropped\":" + dropped.to_string() + ",\"kept\":" + keep.to_string() + "}");
    }
    if name == "estimate_tokens" {
        return mcp_tool_wrap(mcp_token_estimate(mcp_tool_arg_string(args, "text", "")));
    }
    if name == "token_status" { return mcp_tool_wrap(mcp_token_status(s)); }
    if name == "token_ingest" {
        return mcp_tool_wrap(mcp_token_ingest(s, mcp_tool_arg_string(args, "text", "")));
    }
    return "{\"error\":\"unknown tool: " + name + "\"}";
}

fn mcp_tool_rfc_name(name: String) -> String {
    if str_starts_with(name, "RFC-") { return name; }
    if str_starts_with(name, "000") { return "RFC-" + name; }
    return "RFC-" + name;
}

fn mcp_tool_practice_name(name: String) -> String {
    if name == "8d-red-team" { return "REDTEAM"; }
    if name == "ooda-workflow" { return "WORKFLOW"; }
    if name == "release" { return "RELEASE"; }
    return name;
}
