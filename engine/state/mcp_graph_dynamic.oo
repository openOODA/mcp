// # MCP Self-Orienting Dynamic Graph
//
// Logline: A persistent log of method/tool/resource hits, folded into tiers and shadow-cap annotations.
//
// Setup: Pure functional on top of a graph struct. Persistence uses FsReadCap+FsWriteCap.
//
// Beats:
//   1. Record a hit: mcp_dynamic_record(graph, kind, name) increments count and updates last_seen.
//   2. Fold the log: mcp_dynamic_fold(graph) computes hot/cold tiers and surfaces shadow caps.
//   3. Serialize to JSON for the state file.
//   4. Persist via FsWriteCap; load via FsReadCap.

pub fn dynamic_kind_method()   -> Int { return 0; }
pub fn dynamic_kind_tool()     -> Int { return 1; }
pub fn dynamic_kind_unknown()  -> Int { return 2; }

type McpUsageEntry = struct {
    kind: Int,
    name: String,
    count: Int,
    last_seen_epoch: Int
};

type McpDynamicGraph = struct {
    entries: List[McpUsageEntry],
    hot: List[String],
    cold: List[String],
    unused: List[String],
    shadow: List[String],
    fold_epoch: Int
};

pub fn mcp_dynamic_new() -> McpDynamicGraph {
    let entries: List[McpUsageEntry] = list_new();
    let hot: List[String] = list_new();
    let cold: List[String] = list_new();
    let unused: List[String] = list_new();
    let shadow: List[String] = list_new();
    return McpDynamicGraph {
        entries: entries, hot: hot, cold: cold,
        unused: unused, shadow: shadow, fold_epoch: 0
    };
}

fn mcp_dynamic_find(g: &McpDynamicGraph, kind: Int, name: String) -> Int {
    let entries: List[McpUsageEntry] = g.entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let e: McpUsageEntry = list_get(entries, i);
        if e.kind == kind && e.name == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn mcp_dynamic_record(g: &mut McpDynamicGraph, kind: Int, name: String, epoch: Int) {
    let idx: Int = mcp_dynamic_find(g, kind, name);
    if idx < 0 {
        if list_len(g.entries) >= 256 { return; }
        let e: McpUsageEntry = McpUsageEntry { kind: kind, name: name, count: 1, last_seen_epoch: epoch };
        g.entries = list_push(g.entries, e);
        return;
    }
    let mut e: McpUsageEntry = list_get(g.entries, idx);
    e.count = e.count + 1;
    e.last_seen_epoch = epoch;
    g.entries = list_set(g.entries, idx, e);
}

pub fn mcp_dynamic_fold(g: &mut McpDynamicGraph, epoch: Int) {
    let empty_hot: List[String] = list_new();
    let empty_cold: List[String] = list_new();
    let empty_unused: List[String] = list_new();
    let empty_shadow: List[String] = list_new();
    g.hot = empty_hot;
    g.cold = empty_cold;
    g.unused = empty_unused;
    g.shadow = empty_shadow;
    let entries: List[McpUsageEntry] = g.entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        let e: McpUsageEntry = list_get(entries, i);
        if e.kind == dynamic_kind_unknown() { g.shadow = list_push(g.shadow, e.name); }
        else if e.count >= 50 { g.hot = list_push(g.hot, e.name); }
        else if e.count >= 10 { g.cold = list_push(g.cold, e.name); }
        else { g.unused = list_push(g.unused, e.name); }
        i = i + 1;
    }
    g.fold_epoch = epoch;
}

pub fn mcp_dynamic_to_json(g: &McpDynamicGraph) -> String {
    let mut entries_json: String = "[";
    let entries: List[McpUsageEntry] = g.entries;
    let n: Int = list_len(entries);
    let mut i: Int = 0;
    while i < n {
        if i > 0 { entries_json = entries_json + ","; }
        let e: McpUsageEntry = list_get(entries, i);
        let ek: Int = e.kind;
        let ec: Int = e.count;
        let et: Int = e.last_seen_epoch;
        let n_safe: String = lsp_jsonrpc_escape(e.name);
        entries_json = entries_json + "{\"kind\":" + ek.to_string() + ",\"name\":\"" + n_safe + "\",\"count\":" + ec.to_string() + ",\"lastSeen\":" + et.to_string() + "}";
        i = i + 1;
    }
    entries_json = entries_json + "]";
    let fe: Int = g.fold_epoch;
    let epoch: String = fe.to_string();
    return "{\"version\":\"" + mcp_protocol_version() + "\",\"foldEpoch\":" + epoch + ",\"entries\":" + entries_json + "}";
}

// S-07: drop the .tmp + atomic-rename mitigation. write_file is sealed.
pub fn mcp_dynamic_persist(fw: &FsWriteCap, g: &McpDynamicGraph, path: String) -> Int {
    let body: String = mcp_dynamic_to_json(g);
    let wr: Result[Void, String] = write_file(fw, path, body);
    if wr.is_err() { return 0; }
    return 1;
}

fn mcp_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut res: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let b: Int = byte_at(c, 0);
        if b >= 48 && b <= 57 {
            res = res * 10 + (b - 48);
        }
        i = i + 1;
    }
    return res;
}

fn mcp_dynamic_json_int(body: String, key: String) -> Int {
    let pat: String = "\"" + key + "\":";
    let plen: Int = chars_len(pat);
    let n: Int = chars_len(body);
    let mut i: Int = 0;
    while i + plen <= n {
        if str_slice(body, i, i + plen) == pat {
            let mut j: Int = i + plen;
            let mut num: String = "";
            while j < n {
                let c: String = char_at(body, j);
                if c == "," || c == "}" || c == " " || c == "\n" || c == "\t" { break; }
                num = num + c;
                j = j + 1;
            }
            return mcp_parse_int(num);
        }
        i = i + 1;
    }
    return 0;
}

fn mcp_dynamic_json_str(body: String, key: String) -> String {
    let pat: String = "\"" + key + "\":\"";
    let plen: Int = chars_len(pat);
    let n: Int = chars_len(body);
    let mut i: Int = 0;
    while i + plen <= n {
        if str_slice(body, i, i + plen) == pat {
            let mut j: Int = i + plen;
            let mut out: String = "";
            while j < n {
                let c: String = char_at(body, j);
                if c == "\"" { return out; }
                out = out + c;
                j = j + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return "";
}

fn mcp_dynamic_entry_at(entries: String, idx: Int) -> String {
    let n: Int = chars_len(entries);
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut count: Int = 0;
    let mut start: Int = 0 - 1;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(entries, i);
        if in_str {
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
        } else if c == "\"" {
            in_str = true;
        } else if c == "{" {
            if depth == 0 && count == idx { start = i; }
            depth = depth + 1;
        } else if c == "}" {
            depth = depth - 1;
            if depth == 0 && start >= 0 { return str_slice(entries, start, i + 1); }
            if depth == 0 { count = count + 1; }
        }
        i = i + 1;
    }
    return "";
}

pub fn mcp_dynamic_load(fs: &FsReadCap, path: String) -> McpDynamicGraph {
    let mut g: McpDynamicGraph = mcp_dynamic_new();
    if !path_exists(fs, path) { return g; }
    let rr: Result[String, String] = read_file(fs, path);
    if rr.is_err() { return g; }
    let text: String = match rr { Ok(s) => s, Err(_) => "" };
    if chars_len(text) == 0 { return g; }
    let head: String = "\"entries\":[";
    let hlen: Int = chars_len(head);
    let hpos: Int = str_index_of(text, head);
    if hpos < 0 { return g; }
    let tail_start: Int = hpos + hlen;
    let n: Int = chars_len(text);
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut end: Int = tail_start;
    while end < n {
        let c: String = char_at(text, end);
        if in_str {
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
        } else if c == "\"" {
            in_str = true;
        } else if c == "[" {
            depth = depth + 1;
        } else if c == "]" {
            if depth == 0 { break; }
            depth = depth - 1;
        }
        end = end + 1;
    }
    let entries: String = str_slice(text, tail_start, end);
    let fold_epoch: Int = mcp_dynamic_json_int(text, "foldEpoch");
    let mut idx: Int = 0;
    while true {
        let entry: String = mcp_dynamic_entry_at(entries, idx);
        if chars_len(entry) < 2 { break; }
        let e: McpUsageEntry = McpUsageEntry { kind: mcp_dynamic_json_int(entry, "kind"), name: mcp_dynamic_json_str(entry, "name"), count: mcp_dynamic_json_int(entry, "count"), last_seen_epoch: mcp_dynamic_json_int(entry, "lastSeen") };
        g.entries = list_push(g.entries, e);
        idx = idx + 1;
    }
    g.fold_epoch = fold_epoch;
    mcp_dynamic_fold(&mut g, fold_epoch);
    return g;
}
pub fn mcp_dynamic_has_data(g: &McpDynamicGraph) -> Bool {
    return list_len(g.entries) > 0;
}
