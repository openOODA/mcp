// # MCP Capability Encoding (NORTHSTAR 14)
//
// Logline: Map the 14 NORTHSTAR capability tokens onto bits 0..13. Unknown tokens return -1.
//
// Setup: Canonical order matches NORTHSTAR.oot §4.2. No FsCap, HttpCap, or BindCap. No skip bits.
//
// Beats:
//   1. mcp_token_to_bit: token -> 0..13 or -1.
//   2. mcp_bit_to_token: bit -> token or "".
//   3. mcp_caps_bitmask_from_graph: OR of every known token in the graph.
//   4. mcp_cap_full_mask: 16383.

import "engine/state/mcp_graph.oo";

pub fn mcp_cap_full_mask() -> Int { return 16383; }

pub fn mcp_token_to_bit(token: String) -> Int {
    if token == "FsReadCap"  { return 0; }
    if token == "FsWriteCap" { return 1; }
    if token == "NetCap"     { return 2; }
    if token == "TcpCap"     { return 3; }
    if token == "UdpCap"     { return 4; }
    if token == "SysCap"     { return 5; }
    if token == "ProcessCap" { return 6; }
    if token == "EnvCap"     { return 7; }
    if token == "TimeCap"    { return 8; }
    if token == "RandCap"    { return 9; }
    if token == "AllocCap"   { return 10; }
    if token == "ThreadCap"  { return 11; }
    if token == "GpuCap"     { return 12; }
    if token == "FfiCap"     { return 13; }
    return 0 - 1;
}

pub fn mcp_bit_to_token(bit: Int) -> String {
    if bit == 0  { return "FsReadCap"; }
    if bit == 1  { return "FsWriteCap"; }
    if bit == 2  { return "NetCap"; }
    if bit == 3  { return "TcpCap"; }
    if bit == 4  { return "UdpCap"; }
    if bit == 5  { return "SysCap"; }
    if bit == 6  { return "ProcessCap"; }
    if bit == 7  { return "EnvCap"; }
    if bit == 8  { return "TimeCap"; }
    if bit == 9  { return "RandCap"; }
    if bit == 10 { return "AllocCap"; }
    if bit == 11 { return "ThreadCap"; }
    if bit == 12 { return "GpuCap"; }
    if bit == 13 { return "FfiCap"; }
    return "";
}

pub fn mcp_cap_fs_read_bit() -> Int { return 1; }

pub fn mcp_caps_bitmask_from_graph(g: &McpGraph) -> Int {
    let mut mask: Int = 0;
    let n: Int = list_len(g.capabilities);
    let mut i: Int = 0;
    while i < n {
        let c: McpCapability = list_get(g.capabilities, i);
        let bit: Int = mcp_token_to_bit(c.token);
        if bit >= 0 { mask = mask + (1 << bit); }
        i = i + 1;
    }
    return mask;
}
