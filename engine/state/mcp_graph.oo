// # MCP Typed Capability Graph
//
// Logline: Build the capability graph: 20 NORTHSTAR tokens, 14 live governance boards, 8 redteam gates.
//
// Setup: Pure constants. Board paths are relative to the codex directory. Ghost boards are absent.
//
// Beats:
//   1. Declare graph records.
//   2. Emit 20 NORTHSTAR tokens. Bits match oodar cap_table.json.
//   3. Emit 14 boards that exist in openOODA governance.
//   4. Emit 8 redteam gates.
//   5. Emit per-tool cap bits and serialize JSON.

pub type McpCapability = struct {
    token: String,
    kind: String,
    layer: String,
    param_count: Int,
    init_required: Bool,
    description: String
};

pub type McpBoard = struct {
    name: String,
    path: String,
    summary: String,
    read_priority: Int
};

pub type McpRedteamGate = struct {
    axis: String,
    dimension: Int,
    probe: String,
    weight: Int
};

pub type McpToolCap = struct { tool: String, required_caps: Int };

pub type McpSubstrate = struct {
    gold_master_sha256: String
};

pub type McpGraph = struct {
    version: String,
    protocol: String,
    board_root: String,
    capabilities: List[McpCapability],
    boards: List[McpBoard],
    redteam_gates: List[McpRedteamGate],
    tool_caps: List[McpToolCap],
    substrate: McpSubstrate
};

pub fn mcp_wire_protocol_version() -> String { return "2024-11-05"; }

pub fn mcp_protocol_accepted(v: String) -> Bool {
    return v == "2024-11-05" || v == "2025-03-26" || v == "2025-06-18";
}

pub fn mcp_cap_push(l: List[McpCapability], token: String, kind: String, layer: String, params: Int, init_req: Bool, desc: String) -> List[McpCapability] {
    let c: McpCapability = McpCapability { token: token, kind: kind, layer: layer, param_count: params, init_required: init_req, description: desc };
    return list_push(l, c);
}

pub fn mcp_cap_new(token: String, kind: String, layer: String, params: Int, init_req: Bool, desc: String) -> McpCapability {
    return McpCapability { token: token, kind: kind, layer: layer, param_count: params, init_required: init_req, description: desc };
}

pub fn mcp_board_new(name: String, path: String, summary: String, prio: Int) -> McpBoard {
    return McpBoard { name: name, path: path, summary: summary, read_priority: prio };
}

pub fn mcp_gate_new(axis: String, dim: Int, probe: String, weight: Int) -> McpRedteamGate {
    return McpRedteamGate { axis: axis, dimension: dim, probe: probe, weight: weight };
}

pub fn mcp_graph_new(gold_sha: String, board_root: String) -> McpGraph {
    return McpGraph {
        version: mcp_wire_protocol_version(),
        protocol: mcp_wire_protocol_version(),
        board_root: board_root,
        capabilities: list_new(),
        boards: list_new(),
        redteam_gates: list_new(),
        tool_caps: list_new(),
        substrate: McpSubstrate { gold_master_sha256: gold_sha }
    };
}

pub fn mcp_graph_push_cap(g: &mut McpGraph, c: McpCapability) { g.capabilities = list_push(g.capabilities, c); }
pub fn mcp_graph_push_board(g: &mut McpGraph, b: McpBoard) { g.boards = list_push(g.boards, b); }
pub fn mcp_graph_push_gate(g: &mut McpGraph, r: McpRedteamGate) { g.redteam_gates = list_push(g.redteam_gates, r); }
pub fn mcp_graph_push_tool_cap(g: &mut McpGraph, t: McpToolCap) { g.tool_caps = list_push(g.tool_caps, t); }

pub fn mcp_graph_canonical_caps() -> List[McpCapability] {
    let mut caps: List[McpCapability] = list_new();
    caps = mcp_cap_push(caps, "FsReadCap",  "fs",   "core", 1, true, "Read filesystem");
    caps = mcp_cap_push(caps, "FsWriteCap", "fs",   "core", 1, true, "Write filesystem");
    caps = mcp_cap_push(caps, "NetCap",     "net",  "core", 0, true, "Raw network");
    caps = mcp_cap_push(caps, "TcpCap",     "net",  "core", 2, true, "TCP");
    caps = mcp_cap_push(caps, "UdpCap",     "net",  "core", 1, true, "UDP");
    caps = mcp_cap_push(caps, "SysCap",     "sys",  "core", 0, true, "System command");
    caps = mcp_cap_push(caps, "ProcessCap", "proc", "core", 0, true, "Spawn process");
    caps = mcp_cap_push(caps, "EnvCap",     "env",  "core", 0, true, "Environment");
    caps = mcp_cap_push(caps, "TimeCap",    "time", "core", 0, true, "Clock");
    caps = mcp_cap_push(caps, "RandCap",    "rand", "core", 0, true, "Randomness");
    caps = mcp_cap_push(caps, "AllocCap",   "mem",  "core", 0, true, "Heap");
    caps = mcp_cap_push(caps, "ThreadCap",  "thr",  "core", 0, true, "Threads");
    caps = mcp_cap_push(caps, "GpuCap",          "gpu",  "hw",   0, true, "GPU");
    caps = mcp_cap_push(caps, "FfiCap",          "ffi",  "core", 0, true, "Foreign function");
    caps = mcp_cap_push(caps, "FsCap",           "fs",   "core", 1, true, "Filesystem (subsumes read/write)");
    caps = mcp_cap_push(caps, "ArenaCap",        "mem",  "core", 1, true, "Arena");
    caps = mcp_cap_push(caps, "MetricsCap",      "met",  "core", 1, true, "Metrics");
    caps = mcp_cap_push(caps, "SignCap",         "sec",  "core", 1, true, "Sign");
    caps = mcp_cap_push(caps, "BindCap",         "net",  "core", 1, true, "Bind");
    caps = mcp_cap_push(caps, "CompilerReadCap", "cmp",  "core", 1, true, "Compiler read");
    return caps;
}

pub fn mcp_graph_canonical_substrate_caps() -> List[McpCapability] {
    let mut subs: List[McpCapability] = mcp_graph_canonical_caps();
    subs = mcp_cap_push(subs, "AudioCap",        "aud",  "app",  1, true, "Audio (future)");
    subs = mcp_cap_push(subs, "CameraCap",       "cam",  "app",  1, true, "Camera (future)");
    subs = mcp_cap_push(subs, "UsbCap",          "usb",  "app",  1, true, "USB (future)");
    subs = mcp_cap_push(subs, "HidCap",          "hid",  "app",  1, true, "HID (future)");
    subs = mcp_cap_push(subs, "WindowCap",       "win",  "app",  1, true, "Window (future)");
    subs = mcp_cap_push(subs, "FrameCap",        "frm",  "app",  1, true, "Frame (future)");
    return subs;
}

pub fn mcp_graph_canonical_boards() -> List[McpBoard] {
    let mut out: List[McpBoard] = list_new();
    out = list_push(out, mcp_board_new("ANCHOR",    "anchor.oo",                                  "Agent front door", 1));
    out = list_push(out, mcp_board_new("RULES",     "rules.oot",                                   "23 laws", 2));
    out = list_push(out, mcp_board_new("NORTHSTAR", "northstar.oot",                               "Architecture north star", 3));
    out = list_push(out, mcp_board_new("RFC-0001",  "rfcs/0001-capability-security.oot",           "Capability security", 4));
    out = list_push(out, mcp_board_new("RFC-0002",  "rfcs/0002-design-by-contract.oot",            "Design by contract", 5));
    out = list_push(out, mcp_board_new("RFC-0003",  "rfcs/0003-file-format.oot",                   "File format", 6));
    out = list_push(out, mcp_board_new("RFC-0004",  "rfcs/0004-engineering-model.oot",             "Engineering model", 7));
    out = list_push(out, mcp_board_new("RFC-0005",  "rfcs/0005-tactical-subsystem-template.oot",   "Subsystem template", 8));
    out = list_push(out, mcp_board_new("RFC-0006",  "rfcs/0006-versioning-and-release-protocol.oot","Auto-release", 9));
    out = list_push(out, mcp_board_new("RFC-0007",  "rfcs/0007-blackbox-flight-recorder.oot",      "Blackbox flight recorder", 10));
    out = list_push(out, mcp_board_new("REDTEAM",   "practices/8d-red-team.oot",                   "8D red team", 11));
    out = list_push(out, mcp_board_new("WORKFLOW",  "practices/ooda-workflow.oot",                 "OODA workflow", 12));
    out = list_push(out, mcp_board_new("RELEASE",   "practices/release.oot",                       "Release practice", 13));
    out = list_push(out, mcp_board_new("SPEC",      "spec.oot",                                    "Language specification", 14));
    return out;
}

pub fn mcp_graph_canonical_gates() -> List[McpRedteamGate] {
    let mut out: List[McpRedteamGate] = list_new();
    out = list_push(out, mcp_gate_new("subversion",  1, "forged cap bit rejected", 20));
    out = list_push(out, mcp_gate_new("exhaustion",  2, "rate window blocks overflow", 20));
    out = list_push(out, mcp_gate_new("obfuscation", 3, "unknown tool name rejected", 15));
    out = list_push(out, mcp_gate_new("injection",   4, "method is exact, not a pattern", 15));
    out = list_push(out, mcp_gate_new("replay",      5, "duplicate id rejected", 15));
    out = list_push(out, mcp_gate_new("traversal",   6, "non-canonical URI rejected", 15));
    out = list_push(out, mcp_gate_new("escalation",  7, "missing FsReadCap rejected", 15));
    out = list_push(out, mcp_gate_new("integrity",   8, "unknown token returns -1", 15));
    return out;
}

pub fn mcp_graph_canonical_tool_caps() -> List[McpToolCap] {
    let mut out: List[McpToolCap] = list_new();
    out = list_push(out, McpToolCap { tool: "get_capability_graph",    required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_orientation",         required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "read_board",              required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "get_audit_log",           required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_board_index",         required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "summarize_board",         required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "compress_orient",         required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_context_budget",      required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_ooda_phase",          required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_decision_journal",    required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_redteam_realtime",    required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_session_diagnostics", required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_format_constraints",  required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "validate_codex_format",   required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "get_northstar",           required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "get_rules",               required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "get_rfc",                 required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "get_practice",            required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "audit_compact",           required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "estimate_tokens",         required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "token_status",            required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "token_ingest",            required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "attenuate_capability",     required_caps: 0 });
    out = list_push(out, McpToolCap { tool: "oodac_check",              required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "oodac_emit",               required_caps: 8 });
    out = list_push(out, McpToolCap { tool: "oodac_build",              required_caps: 8 });
    return out;
}

pub fn mcp_graph_canonical(gold_sha: String, board_root: String) -> McpGraph {
    let mut g: McpGraph = mcp_graph_new(gold_sha, board_root);
    g.capabilities = mcp_graph_canonical_caps();
    let brds: List[McpBoard] = mcp_graph_canonical_boards();
    let mut j: Int = 0;
    while j < list_len(brds) { mcp_graph_push_board(&mut g, list_get(brds, j)); j = j + 1; }
    let gts: List[McpRedteamGate] = mcp_graph_canonical_gates();
    let mut k: Int = 0;
    while k < list_len(gts) { mcp_graph_push_gate(&mut g, list_get(gts, k)); k = k + 1; }
    g.tool_caps = mcp_graph_canonical_tool_caps();
    return g;
}

pub fn mcp_graph_cap_to_json(c: &McpCapability) -> String {
    let init_str: String = if c.init_required { "true" } else { "false" };
    return "{\"token\":\"" + c.token + "\",\"kind\":\"" + c.kind + "\",\"layer\":\"" + c.layer + "\",\"params\":" + c.param_count.to_string() + ",\"initRequired\":" + init_str + ",\"description\":\"" + c.description + "\"}";
}

fn mcp_graph_board_to_json(b: &McpBoard) -> String {
    return "{\"name\":\"" + b.name + "\",\"path\":\"" + b.path + "\",\"summary\":\"" + b.summary + "\",\"readPriority\":" + b.read_priority.to_string() + "}";
}

fn mcp_graph_gate_to_json(r: &McpRedteamGate) -> String {
    return "{\"axis\":\"" + r.axis + "\",\"dimension\":" + r.dimension.to_string() + ",\"probe\":\"" + r.probe + "\",\"weight\":" + r.weight.to_string() + "}";
}

pub fn mcp_graph_to_json(g: &McpGraph) -> String {
    let mut caps_json: String = "";
    let mut i: Int = 0;
    while i < list_len(g.capabilities) {
        if i > 0 { caps_json = caps_json + ","; }
        let c: McpCapability = list_get(g.capabilities, i);
        caps_json = caps_json + mcp_graph_cap_to_json(&c);
        i = i + 1;
    }
    let mut brds_json: String = "";
    let mut j: Int = 0;
    while j < list_len(g.boards) {
        if j > 0 { brds_json = brds_json + ","; }
        let b: McpBoard = list_get(g.boards, j);
        brds_json = brds_json + mcp_graph_board_to_json(&b);
        j = j + 1;
    }
    let mut gts_json: String = "";
    let mut k: Int = 0;
    while k < list_len(g.redteam_gates) {
        if k > 0 { gts_json = gts_json + ","; }
        let gt: McpRedteamGate = list_get(g.redteam_gates, k);
        gts_json = gts_json + mcp_graph_gate_to_json(&gt);
        k = k + 1;
    }
    return "{\"version\":\"" + g.version + "\",\"protocol\":\"" + g.protocol + "\",\"boardRoot\":\"" + g.board_root + "\",\"capabilities\":[" + caps_json + "],\"boards\":[" + brds_json + "],\"redteamGates\":[" + gts_json + "],\"goldMasterSha256\":\"" + g.substrate.gold_master_sha256 + "\"}";
}
