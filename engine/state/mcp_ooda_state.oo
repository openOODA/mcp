// # MCP OODA State
//
// Logline: Expose phase, decision journal, live redteam fire, and session diagnostics.
//
// Setup: Phase ints live on McpSession. Redteam fire is stateless. Journal filters the audit log.
//
// Beats:
//   1. Phase label.
//   2. Last N substantive audit entries.
//   3. Live 8-gate fire.
//   4. Session snapshot.

import "engine/core/mcp_session.oo";
import "engine/health/mcp_audit.oo";
import "engine/state/mcp_graph.oo";
import "engine/health/mcp_redteam.oo";

pub fn mcp_ooda_state_idle() -> Int { return 0; }
pub fn mcp_ooda_state_orient() -> Int { return 1; }
pub fn mcp_ooda_state_decide() -> Int { return 2; }
pub fn mcp_ooda_state_act() -> Int { return 3; }

pub fn mcp_ooda_state_get_phase(s: &McpSession) -> String {
    let label: String = if s.ooda_phase == 0 { "idle" } else if s.ooda_phase == 1 { "orient" } else if s.ooda_phase == 2 { "decide" } else if s.ooda_phase == 3 { "act" } else { "unknown" };
    return "{\"phase\":" + s.ooda_phase.to_string() + ",\"label\":\"" + label + "\"}";
}

pub fn mcp_ooda_state_get_decision_journal(s: &McpSession, n: Int) -> String {
    let entries: List[McpAuditEntry] = s.audit_log;
    let total: Int = list_len(entries);
    if total == 0 { return "[]"; }
    let mut out: String = "[";
    let mut count: Int = 0;
    let mut i: Int = total - 1;
    let mut first: Bool = true;
    while i >= 0 && (n <= 0 || count < n) {
        let e: McpAuditEntry = list_get(entries, i);
        let m: String = e.method;
        if m == "tools/call" || m == "resources/read" || m == "prompts/get" || m == "roots/list" {
            if !first { out = out + ","; }
            out = out + mcp_audit_entry_to_json(&e);
            first = false;
            count = count + 1;
        }
        i = i - 1;
    }
    return out + "]";
}

pub fn mcp_ooda_state_get_redteam_realtime() -> String {
    return mcp_redteam_run_all_json();
}

pub fn mcp_ooda_state_get_session_diagnostics(s: &McpSession, g: &McpGraph) -> String {
    return "{\"phase\":" + s.phase.to_string() + ",\"tier\":" + s.tier.to_string() + ",\"ooda_phase\":" + s.ooda_phase.to_string() + ",\"request_seq\":" + s.request_seq.to_string() + ",\"bytes_in\":" + s.bytes_in.to_string() + ",\"bytes_out\":" + s.bytes_out.to_string() + ",\"caps_held\":" + s.caps_held.to_string() + ",\"rate_window_count\":" + s.rate_window_count.to_string() + ",\"audit_count\":" + list_len(s.audit_log).to_string() + ",\"pending_notifs\":" + list_len(s.pending_notifications).to_string() + ",\"seen_ids\":" + list_len(s.seen_ids).to_string() + ",\"client_roots\":" + list_len(s.client_roots).to_string() + ",\"cancelled\":" + (if s.cancelled { "true" } else { "false" }) + ",\"graph_caps\":" + list_len(g.capabilities).to_string() + ",\"graph_boards\":" + list_len(g.boards).to_string() + ",\"graph_gates\":" + list_len(g.redteam_gates).to_string() + ",\"graph_tool_caps\":" + list_len(g.tool_caps).to_string() + "}";
}
