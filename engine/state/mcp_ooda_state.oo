// # MCP OODA State — OODA-Loop Visibility Tools
//
// Logline: Expose 4 OODA-state primitives so the LLM client can see which OODA phase the server is in, what decisions it has made, what the live redteam state is, and a comprehensive session diagnostic.
//
// Setup: Tier 2 of the blue-ocean MCP expansion. McpSession carries ooda_phase: Int (0=idle, 1=orient, 2=decide, 3=act). mcp_server_handle_body updates it during the OODA pass. decision_journal filters the audit log to substantive methods (tools/call, resources/read, prompts/get, roots/list). get_redteam_realtime fires the 8 redteam gates on demand (cheap; the real probes from F-01 are stateless). get_session_diagnostics is a one-call health snapshot.
//
// Beats:
//   1. mcp_ooda_state_get_phase — current phase + label.
//   2. mcp_ooda_state_get_decision_journal — last N substantive decisions (filtered audit log).
//   3. mcp_ooda_state_get_redteam_realtime — live fire of all 8 gates, returned as JSON array.
//   4. mcp_ooda_state_get_session_diagnostics — full session health snapshot.

import "lsp/wire/lsp_jsonrpc.oo";
import "engine/core/mcp_session.oo";
import "engine/health/mcp_audit.oo";
import "engine/state/mcp_graph.oo";
import "engine/health/mcp_redteam.oo";

pub fn mcp_ooda_state_idle() -> Int { return 0; }
pub fn mcp_ooda_state_orient() -> Int { return 1; }
pub fn mcp_ooda_state_decide() -> Int { return 2; }
pub fn mcp_ooda_state_act() -> Int { return 3; }

pub fn mcp_ooda_state_get_phase(s: &McpSession) -> String {
    let label: String = if s.ooda_phase == 0 { "idle" } else if s.ooda_phase == 1 { "orient" } else if s.ooda_phase == 2 { "decide" } else if s.ooda_phase == 3 { "act" } else { "unknown" };
    return "{\"phase\":" + s.ooda_phase.to_string() + ",\"label\":\"" + label + "\"}";
}

pub fn mcp_ooda_state_get_decision_journal(s: &McpSession, n: Int) -> String {
    let entries: List[McpAuditEntry] = s.audit_log;
    let total: Int = list_len(entries);
    if total == 0 { return "[]"; }
    let mut out: String = "[";
    let mut count: Int = 0;
    let mut i: Int = total - 1;
    let mut first: Bool = true;
    while i >= 0 && (n <= 0 || count < n) {
        let e: McpAuditEntry = list_get(entries, i);
        let m: String = e.method;
        let is_substantive: Bool = m == "tools/call" || m == "resources/read" || m == "prompts/get" || m == "roots/list";
        if is_substantive {
            if !first { out = out + ","; }
            out = out + mcp_audit_entry_to_json(&e);
            first = false;
            count = count + 1;
        }
        i = i - 1;
    }
    return out + "]";
}

pub fn mcp_ooda_state_get_redteam_realtime() -> String {
    let mut out: String = "[";
    let mut gate: Int = 1;
    while gate <= 8 {
        if gate > 1 { out = out + ","; }
        out = out + mcp_redteam_fire(gate);
        gate = gate + 1;
    }
    return out + "]";
}

pub fn mcp_ooda_state_get_session_diagnostics(s: &McpSession, g: &McpGraph) -> String {
    return "{\"phase\":" + s.phase.to_string() + ",\"tier\":" + s.tier.to_string() + ",\"ooda_phase\":" + s.ooda_phase.to_string() + ",\"request_seq\":" + s.request_seq.to_string() + ",\"bytes_in\":" + s.bytes_in.to_string() + ",\"bytes_out\":" + s.bytes_out.to_string() + ",\"caps_held\":" + s.caps_held.to_string() + ",\"rate_window_count\":" + s.rate_window_count.to_string() + ",\"audit_count\":" + list_len(s.audit_log).to_string() + ",\"pending_notifs\":" + list_len(s.pending_notifications).to_string() + ",\"seen_ids\":" + list_len(s.seen_ids).to_string() + ",\"client_roots\":" + list_len(s.client_roots).to_string() + ",\"cancelled\":" + s.cancelled.to_string() + ",\"graph_caps\":" + list_len(g.capabilities).to_string() + ",\"graph_boards\":" + list_len(g.boards).to_string() + ",\"graph_gates\":" + list_len(g.redteam_gates).to_string() + ",\"graph_tool_caps\":" + list_len(g.tool_caps).to_string() + "}";
}
