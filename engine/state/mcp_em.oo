// # E-M Telemetry Snapshot
//
// Logline: Compute Ps=((T-D)/W)*V from session and graph counts for the audit-tier resource.
//
// Setup: Pure over McpSession and McpGraph. No registry file. No silent empty catalog.
//
// Beats:
//   1. T = caps + boards + gates.
//   2. D = pending notifications + seen ids.
//   3. V = request_seq. W = 256.

import "engine/core/mcp_session.oo";
import "engine/state/mcp_graph.oo";

pub fn mcp_em_snapshot(s: &McpSession, g: &McpGraph) -> String {
    let t: Int = list_len(g.capabilities) + list_len(g.boards) + list_len(g.redteam_gates);
    let d: Int = list_len(s.pending_notifications) + list_len(s.seen_ids);
    let v: Int = s.request_seq;
    let ps: Int = if v == 0 { 0 } else { ((t - d) * v) / 256 };
    return "{\"ps\":" + ps.to_string() + ",\"t\":" + t.to_string() + ",\"d\":" + d.to_string() + ",\"w\":256,\"v\":" + v.to_string() + ",\"protocol\":\"" + g.protocol + "\",\"sha\":\"" + g.substrate.gold_master_sha256 + "\"}";
}

pub fn mcp_em_ps(s: &McpSession, g: &McpGraph) -> Int {
    let t: Int = list_len(g.capabilities) + list_len(g.boards) + list_len(g.redteam_gates);
    let d: Int = list_len(s.pending_notifications) + list_len(s.seen_ids);
    let v: Int = s.request_seq;
    if v == 0 { return 0; }
    return ((t - d) * v) / 256;
}
