// # MCP Notification Queue
//
// Logline: Queue cap-revocation notifications and append them to the response.
//
// Setup: Revalidate held bits against the graph mask. Revoked bits enqueue one notification.
//
// Beats:
//   1. Queue and drain.
//   2. Append drained frames to the response.
//   3. Revalidate caps and enqueue revocations.

import "engine/state/mcp_graph.oo";
import "engine/core/mcp_session.oo";
import "engine/state/mcp_cap.oo";
import "engine/core/mcp_transport.oo";

pub fn mcp_queue_notification(s: &mut McpSession, notif: String) -> Int {
    if chars_len(notif) == 0 { return 0; }
    s.pending_notifications = list_push(s.pending_notifications, notif);
    return 1;
}

pub fn mcp_pending_count(s: &McpSession) -> Int {
    return list_len(s.pending_notifications);
}

pub fn mcp_drain_into_response(s: &mut McpSession, raw: String, response: String) -> String {
    let n: Int = mcp_pending_count(s);
    if n == 0 { return response; }
    let mut out: String = response;
    let mut i: Int = 0;
    while i < n {
        let entry: String = list_get(s.pending_notifications, i);
        if chars_len(entry) > 0 { out = out + mcp_transport_emit(raw, entry); }
        i = i + 1;
    }
    s.pending_notifications = list_new();
    return out;
}

pub fn mcp_revalidate_and_queue_caps(s: &mut McpSession, g: &McpGraph) -> String {
    let before: Int = s.caps_held;
    let valid_mask: Int = mcp_caps_bitmask_from_graph(g);
    s.caps_held = s.caps_held & valid_mask;
    let revoked_bits: Int = before - (before & valid_mask);
    if revoked_bits == 0 { return ""; }
    let mut revoked: String = "";
    let mut bit: Int = 0;
    while bit < 14 {
        let mask: Int = 1 << bit;
        if (before & mask) > 0 && (valid_mask & mask) == 0 {
            let name: String = mcp_bit_to_token(bit);
            if chars_len(name) > 0 {
                if chars_len(revoked) > 0 { revoked = revoked + ","; }
                revoked = revoked + "\"" + name + "\"";
            }
        }
        bit = bit + 1;
    }
    if chars_len(revoked) == 0 { return ""; }
    let notif: String = "{\"method\":\"notifications/cap_revoked\",\"params\":{\"revoked\":[" + revoked + "]}}";
    let _: Int = mcp_queue_notification(s, notif);
    return notif;
}
