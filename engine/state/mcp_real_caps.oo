// # Real-Cap Tests
//
// Logline: 10 capability probes for the G11 self-certify. Each probe delegates to runtime_cap_present(name), a runtime builtin the runtime must provide. The .oo file defaults to returning -1 (skip); the runtime overrides runtime_cap_present with a real implementation that returns 0 when the cap is supported, -1 when not.
//
// Setup: mcp_certify_real(token, runtime_result) returns "pass" if the runtime probe is non-negative, "skip" with reason if the runtime lacks the builtin. Caller is mcp_g11_self_certify in mcp_redteam.oo.
//
// Beats:
//   1. runtime_cap_present(name): default -1; runtime provides real impl.
//   2. 10 runtime_*_probe(): each is a one-line delegation to runtime_cap_present.
//   3. mcp_certify_real: emit a JSON line for one cap based on the runtime probe result.

// Default impl: the runtime provides a real implementation. Until it does,
// all caps report -1 (skip).
fn runtime_cap_present(cap: String) -> Int { return 0 - 1; }

fn runtime_sys_probe() -> Int { return runtime_cap_present("SysCap"); }
fn runtime_process_probe() -> Int { return runtime_cap_present("ProcessCap"); }
fn runtime_net_probe() -> Int { return runtime_cap_present("NetCap"); }
fn runtime_http_probe() -> Int { return runtime_cap_present("HttpCap"); }
fn runtime_tcp_probe() -> Int { return runtime_cap_present("TcpCap"); }
fn runtime_udp_probe() -> Int { return runtime_cap_present("UdpCap"); }
fn runtime_time_probe() -> Int { return runtime_cap_present("TimeCap"); }
fn runtime_rand_probe() -> Int { return runtime_cap_present("RandCap"); }
fn runtime_alloc_probe() -> Int { return runtime_cap_present("AllocCap"); }
fn runtime_fs_probe() -> Int { return runtime_cap_present("FsCap"); }

// Emit a cert line for one cap. If the runtime probe is non-negative, "pass"; if negative, "skip" with reason.
pub fn mcp_certify_real(token: String, runtime_result: Int) -> String {
    if runtime_result < 0 { return "{\"cap\":\"" + token + "\",\"result\":\"skip\",\"reason\":\"runtime-lacks-builtin\"}"; }
    return "{\"cap\":\"" + token + "\",\"result\":\"pass\"}";
}
