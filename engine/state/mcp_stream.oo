// # MCP Stream (OODA Act streaming via notifications/progress)
//
// Logline: Build a sequence of JSON-RPC notifications/progress frames for a partial resource read, with cancel via $/cancelRequest.
//
// Setup: Pure string assembly. The Act phase calls mcp_stream_build to construct the framed notifications, and mcp_stream_should_cancel to short-circuit on cancel.
//
// Beats:
//   1. mcp_stream_build produces N progress frames for a list of N parts.
//   2. mcp_stream_emit combines all frames into one output string.
//   3. mcp_stream_should_cancel returns true iff the cancel field in the session is set.

import "engine/core/mcp_session.oo";

// Build one progress frame. messageId is the request id; token is the progress label.
pub fn mcp_stream_progress(message_id: String, token: String, value: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":\"" + token + "\",\"messageId\":" + message_id + ",\"value\":\"" + value + "\"}}";
}

// Build a list of progress frames from a parts list. Each part is sent in its own frame.
pub fn mcp_stream_build(message_id: String, token: String, parts: List[String]) -> String {
    let mut out: String = "";
    let n: Int = list_len(parts);
    let mut i: Int = 0;
    while i < n {
        let p: String = list_get(parts, i);
        out = out + mcp_stream_progress(message_id, token, p) + "\n";
        i = i + 1;
    }
    return out;
}

// Mark the session as cancelled.
pub fn mcp_session_set_cancelled(s: &mut McpSession, value: Bool) {
    s.cancelled = value;
}

// True iff the session has been cancelled mid-stream.
pub fn mcp_stream_should_cancel(s: &McpSession) -> Bool {
    return s.cancelled;
}
