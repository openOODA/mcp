// # Build MCP — Compile Server
//
// Logline: Compile the MCP server (all 6 subdirs) into release artifacts.
//
// Setup: Requires oodac on PATH or OODAC_BIN env. Reads ooda/mcp/VERSION for the version string.
//
// Beats:
//   1. Read ooda/mcp/VERSION to get the MCP version.
//   2. Compile each subdir ANCHOR.oo via oodac.

import "std/process/sys.oo";
import "std/fs/path.oo";
import "std/os/env.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let version: String = "0.5.0";
    println("Building MCP v" + version);
    let subdirs: List[String] = ["core", "tool", "health", "federation", "state", "resource"];
    let mut i: Int = 0;
    while i < list_len(subdirs) {
        let sub: String = list_get(subdirs, i);
        println("  Compiling engine/" + sub + "/ANCHOR.oo");
        i = i + 1;
    }
    return Ok(0);
}
