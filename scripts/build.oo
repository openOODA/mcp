// # Build MCP
//
// Logline: Fail closed if a production source file is missing. oodac compiles cli/main.oo.
//
// Setup: FsReadCap. This process does not spawn oodac. It gates the source tree named build per RFC-0005.
//
// Beats:
//   1. Read every production .oo path.
//   2. Err if any path is missing or unreadable.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let mut files: List[String] = list_new();
    files = list_push(files, "cli/main.oo");
    files = list_push(files, "cli/cmd_mcp.oo");
    files = list_push(files, "cli/safe_merge.oo");
    files = list_push(files, "cli/safe_merge_core.oo");
    files = list_push(files, "engine/core/mcp_json.oo");
    files = list_push(files, "engine/core/mcp_batch.oo");
    files = list_push(files, "engine/core/mcp_dispatch.oo");
    files = list_push(files, "engine/core/mcp_server.oo");
    files = list_push(files, "engine/core/mcp_session.oo");
    files = list_push(files, "engine/core/mcp_stdio.oo");
    files = list_push(files, "engine/core/mcp_transport.oo");
    files = list_push(files, "engine/federation/mcp_codex.oo");
    files = list_push(files, "engine/health/mcp_audit.oo");
    files = list_push(files, "engine/health/mcp_redteam.oo");
    files = list_push(files, "engine/resource/mcp_context_budget.oo");
    files = list_push(files, "engine/resource/mcp_format.oo");
    files = list_push(files, "engine/resource/mcp_schema.oo");
    files = list_push(files, "engine/state/mcp_cap.oo");
    files = list_push(files, "engine/state/mcp_em.oo");
    files = list_push(files, "engine/state/mcp_graph.oo");
    files = list_push(files, "engine/state/mcp_notification.oo");
    files = list_push(files, "engine/state/mcp_ooda_state.oo");
    files = list_push(files, "engine/state/mcp_roots.oo");
    files = list_push(files, "engine/tool/mcp_tool.oo");
    files = list_push(files, "engine/tool/mcp_tool_dispatch.oo");
    files = list_push(files, "engine/tool/mcp_tool_token.oo");
    let mut i: Int = 0;
    while i < list_len(files) {
        let path: String = list_get(files, i);
        if !path_exists(fs_r, path) { return Err("missing source: " + path); }
        let rr: Result[String, String] = read_file(fs_r, path);
        if rr.is_err() { return Err("unreadable source: " + path); }
        i = i + 1;
    }
    println("build: production sources present; compile with oodac cli/main.oo");
    return Ok(0);
}
