// # Build MCP
//
// Logline: Fail closed if a required source file is missing. This package has no VERSION file.
//
// Setup: FsReadCap. Compilation is oodac on cli/main.oo. This script does not print fake compiles.
//
// Beats:
//   1. Read cli/main.oo, engine ANCHOR, and qa ANCHOR.
//   2. Err if any read fails.

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let files: List[String] = ["cli/main.oo", "cli/cmd_mcp.oo", "engine/ANCHOR.oo", "engine/core/mcp_server.oo", "engine/core/mcp_json.oo", "qa/ANCHOR.oo", "ANCHOR.oo"];
    let mut i: Int = 0;
    while i < list_len(files) {
        let path: String = list_get(files, i);
        if !path_exists(fs_r, path) { return Err("missing source: " + path); }
        let rr: Result[String, String] = read_file(fs_r, path);
        if rr.is_err() { return Err("unreadable source: " + path); }
        i = i + 1;
    }
    println("build: required MCP sources present");
    return Ok(0);
}
