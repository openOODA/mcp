// # Release MCP
//
// Logline: Fail closed unless verify_surface passes. Push to main is the release (RFC-0006).
//
// Setup: No tarball. No VERSION bump. No fake four-step print.
//
// Beats:
//   1. Run mcp_verify_surface.
//   2. Return its Result.

import "verify.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    println("release: verify surface; git push to main ships the tag");
    return mcp_verify_surface();
}
