// # Test MCP
//
// Logline: Run the ten probe functions and the surface verifier. Any Err fails the package.
//
// Setup: In-process. Merge probe needs FsWriteCap. No fake passed++.
//
// Beats:
//   1. verify surface.
//   2. Run ten probes.
//   3. Return the first Err.

import "../qa/probe_initialize.oo";
import "../qa/probe_tools_list.oo";
import "../qa/probe_tool_call.oo";
import "../qa/probe_resources_list.oo";
import "../qa/probe_ping.oo";
import "../qa/probe_double_run.oo";
import "../qa/probe_merge.oo";
import "../qa/probe_redteam.oo";
import "../qa/probe_token.oo";
import "../qa/probe_protocol.oo";
import "verify.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let v: Result[Int, String] = mcp_verify_surface();
    if v.is_err() { return v; }
    let a: Result[Int, String] = probe_initialize_run(fs_r);
    if a.is_err() { return a; }
    let b: Result[Int, String] = probe_tools_list_run(fs_r);
    if b.is_err() { return b; }
    let c: Result[Int, String] = probe_tool_call_run(fs_r);
    if c.is_err() { return c; }
    let d: Result[Int, String] = probe_resources_list_run(fs_r);
    if d.is_err() { return d; }
    let e: Result[Int, String] = probe_ping_run(fs_r);
    if e.is_err() { return e; }
    let f: Result[Int, String] = probe_double_run_run(fs_r);
    if f.is_err() { return f; }
    let h: Result[Int, String] = probe_merge_run(fs_r, fw);
    if h.is_err() { return h; }
    let r: Result[Int, String] = probe_redteam_run();
    if r.is_err() { return r; }
    let t: Result[Int, String] = probe_token_run(fs_r);
    if t.is_err() { return t; }
    let pr: Result[Int, String] = probe_protocol_run(fs_r);
    if pr.is_err() { return pr; }
    println("test: 10 probes + verify passed");
    return Ok(0);
}
