// # MCP Verify Surface Core
//
// Logline: Fail closed if cap inventory, boards, or tools drift. Zero-trust SSoT.
//
// Setup: Pure graph + FsReadCap reads of oodar sec/cap/caps.h, cap_table.json,
//        and NORTHSTAR 14. 14 subset of 26, SSoT is oodar.
// Beats:
//   1. 14 language caps; 26 substrate caps; subset.
//   2. 12 boards; NORTHSTAR present.
//   3. 23 tools.

import "engine/state/mcp_graph.oo";
import "engine/state/mcp_cap.oo";
import "engine/tool/mcp_tool.oo";

pub fn mcp_verify_surface_zero_trust(fs: &FsReadCap) -> Result[Int, String] {
    let t: Result[String, String] = read_file(fs, "oodar/sec/cap/cap_table.json");
    if t.is_err() { return Err("cap_table.json missing"); }
    let j: String = match t { Ok(s) => s, Err(_) => "" };
    if str_index_of(j, "\"cap_count\": 26") < 0 { return Err("cap_table.json not 26"); }
    let h: Result[String, String] = read_file(fs, "oodar/sec/cap/caps.h");
    if h.is_err() { return Err("caps.h missing"); }
    let hs: String = match h { Ok(s) => s, Err(_) => "" };
    let mut c: Int = 0;
    let mut p: Int = 0;
    let total: Int = chars_len(hs);
    while p < total {
        let sub: String = str_slice(hs, p, total);
        let n: Int = str_index_of(sub, "#define OODAR_CAP_");
        if n < 0 { break; }
        c = c + 1;
        p = p + n + 1;
    }
    if c != 26 { return Err("caps.h not 26, got " + c.to_string()); }
    return mcp_verify_surface();
}

pub fn mcp_verify_surface() -> Result[Int, String] {
    let caps: List[McpCapability] = mcp_graph_canonical_caps();
    if list_len(caps) != 14 { return Err("14 language caps drifted"); }
    let subs: List[McpCapability] = mcp_graph_canonical_substrate_caps();
    if list_len(subs) != 26 { return Err("26 substrate caps drifted"); }
    if mcp_token_to_bit("FfiCap") != 13 { return Err("FfiCap must be bit 13"); }
    if mcp_token_to_bit("ThreadCap") != 11 { return Err("ThreadCap must be bit 11"); }
    if mcp_token_to_bit("FsCap") != 0 - 1 { return Err("FsCap must be unknown"); }
    if mcp_token_to_bit("HttpCap") != 0 - 1 { return Err("HttpCap must be unknown"); }
    if mcp_token_to_bit("BindCap") != 0 - 1 { return Err("BindCap must be unknown"); }
    let mut i: Int = 0;
    while i < list_len(caps) {
        let c: McpCapability = list_get(caps, i);
        if mcp_token_to_bit_substrate(c.token) == 0 - 1 { return Err("14 not subset of 26: " + c.token); }
        i = i + 1;
    }
    let brds: List[McpBoard] = mcp_graph_canonical_boards();
    if list_len(brds) != 12 { return Err("board count drifted"); }
    let mut has_ns: Bool = false;
    let mut j: Int = 0;
    while j < list_len(brds) {
        let b: McpBoard = list_get(brds, j);
        let n: String = b.name;
        if n == "NORTHSTAR" { has_ns = true; }
        if n == "ROADMAP" || n == "SHIPPED" || n == "START" || n == "FORMAT" || n == "MOONSHOTS" {
            return Err("ghost board still present: " + n);
        }
        j = j + 1;
    }
    if !has_ns { return Err("NORTHSTAR board missing"); }
    if mcp_tool_count() != 23 { return Err("tool count drifted"); }
    let g: McpGraph = mcp_graph_canonical("", "");
    if mcp_tool_required_caps(&g, "read_board") != 1 { return Err("read_board must require FsReadCap"); }
    if mcp_tool_required_caps(&g, "get_orientation") != 0 { return Err("get_orientation must require 0"); }
    if mcp_tool_required_caps(&g, "estimate_tokens") != 0 { return Err("estimate_tokens must require 0"); }
    if mcp_tool_required_caps(&g, "token_status") != 0 { return Err("token_status must require 0"); }
    if mcp_tool_required_caps(&g, "token_ingest") != 0 { return Err("token_ingest must require 0"); }
    if mcp_tool_required_caps(&g, "attenuate_capability") != 0 { return Err("attenuate_capability must require 0"); }
    if mcp_tool_required_caps(&g, "estimate_chars") != 0 - 1 { return Err("estimate_chars must be unknown"); }
    if mcp_tool_required_caps(&g, "get_milestone_status") != 0 - 1 { return Err("get_milestone_status must be unknown"); }
    return Ok(0);
}
