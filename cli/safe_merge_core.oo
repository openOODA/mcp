// # MCP Server-Config Safe Merge
//
// Logline: Inject the ooda MCP entry into an existing JSON object without dropping other keys.
//
// Setup: String scan of the mcpServers object. Idempotent on `"ooda":`. Fail closed if the text is not an object.
//
// Beats:
//   1. Locate the mcpServers brace block by index.
//   2. No-op when `"ooda":` is already a key.
//   3. Splice the entry into that block, or add mcpServers before the final brace.

pub fn safe_mcp_merge_ooda_entry() -> String {
    return "\"ooda\":{\"command\":\"ooda\",\"args\":[\"mcp\"]}";
}

fn safe_mcp_merge_brace_end(text: String, start: Int) -> Int {
    let n: Int = chars_len(text);
    let mut depth: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(text, i);
        if in_str {
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
        } else if c == "\"" { in_str = true; }
        else if c == "{" { depth = depth + 1; }
        else if c == "}" {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn safe_mcp_merge_find_key_object(text: String, key: String) -> Int {
    let pat: String = "\"" + key + "\"";
    let n: Int = chars_len(text);
    let plen: Int = chars_len(pat);
    let mut i: Int = 0;
    while i + plen <= n {
        if str_slice(text, i, i + plen) == pat {
            let mut j: Int = i + plen;
            while j < n {
                let c: String = char_at(text, j);
                if c == " " || c == "\t" || c == "\n" || c == "\r" { j = j + 1; continue; }
                if c == ":" { j = j + 1; break; }
                return 0 - 1;
            }
            while j < n {
                let c: String = char_at(text, j);
                if c == " " || c == "\t" || c == "\n" || c == "\r" { j = j + 1; continue; }
                if c == "{" { return j; }
                return 0 - 1;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn safe_mcp_merge_already_has_ooda(text: String) -> Bool {
    let start: Int = safe_mcp_merge_find_key_object(text, "mcpServers");
    if start < 0 { return false; }
    let end: Int = safe_mcp_merge_brace_end(text, start);
    if end < 0 { return false; }
    let block: String = str_slice(text, start, end + 1);
    return str_contains(block, "\"ooda\":");
}

fn safe_mcp_merge_is_empty_object(block: String) -> Bool {
    let n: Int = chars_len(block);
    if n < 2 { return false; }
    let mut i: Int = 1;
    while i < n - 1 {
        let c: String = char_at(block, i);
        if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1; continue; }
        return false;
    }
    return true;
}

pub fn safe_mcp_merge_apply(text: String) -> Result[String, String] {
    if chars_len(text) == 0 { return Err("empty text"); }
    if char_at(text, 0) != "{" { return Err("not json object"); }
    if safe_mcp_merge_already_has_ooda(text) { return Ok(text); }
    let start: Int = safe_mcp_merge_find_key_object(text, "mcpServers");
    if start >= 0 {
        let end: Int = safe_mcp_merge_brace_end(text, start);
        if end < 0 { return Err("unterminated mcpServers"); }
        let block: String = str_slice(text, start, end + 1);
        let entry: String = safe_mcp_merge_ooda_entry();
        let mut new_block: String = "";
        if safe_mcp_merge_is_empty_object(block) {
            new_block = "{" + entry + "}";
        } else {
            new_block = str_slice(block, 0, chars_len(block) - 1) + "," + entry + "}";
        }
        return Ok(str_slice(text, 0, start) + new_block + str_slice(text, end + 1, chars_len(text)));
    }
    let n: Int = chars_len(text);
    let mut k: Int = n - 1;
    while k >= 0 {
        let c: String = char_at(text, k);
        if c == " " || c == "\t" || c == "\n" || c == "\r" { k = k - 1; continue; }
        if c != "}" { return Err("not json object"); }
        let inner: String = str_slice(text, 1, k);
        let mut sep: String = "";
        let mut t: Int = 0;
        let inn: Int = chars_len(inner);
        while t < inn {
            let d: String = char_at(inner, t);
            if d != " " && d != "\t" && d != "\n" && d != "\r" { sep = ","; break; }
            t = t + 1;
        }
        return Ok("{" + inner + sep + "\"mcpServers\":{" + safe_mcp_merge_ooda_entry() + "}}");
    }
    return Err("not json object");
}

pub fn safe_mcp_merge_file(fr: &FsReadCap, fw: &FsWriteCap, path: String) -> Int {
    if !path_exists(fr, path) {
        let wr: Result[Void, String] = write_file(fw, path, "{\"mcpServers\":{" + safe_mcp_merge_ooda_entry() + "}}");
        if wr.is_err() { return 2; }
        return 1;
    }
    let rr: Result[String, String] = read_file(fr, path);
    if rr.is_err() { return 2; }
    let text: String = match rr { Ok(s) => s, Err(_) => "" };
    if chars_len(text) == 0 {
        let wr2: Result[Void, String] = write_file(fw, path, "{\"mcpServers\":{" + safe_mcp_merge_ooda_entry() + "}}");
        if wr2.is_err() { return 2; }
        return 1;
    }
    if safe_mcp_merge_already_has_ooda(text) { return 0; }
    let ar: Result[String, String] = safe_mcp_merge_apply(text);
    if ar.is_err() { return 2; }
    let new_text: String = match ar { Ok(v) => v, Err(_) => "" };
    let wr3: Result[Void, String] = write_file(fw, path, new_text);
    if wr3.is_err() { return 2; }
    return 1;
}
