// # MCP Main — Package Entry Point
//
// Logline: Parse argv and dispatch to the stdio/file server or mcp-merge.
//
// Setup: A leading -- flag is a server flag. Default with no args is stdio.
//
// Beats:
//   1. No args or leading -- → server.
//   2. mcp → server with remaining args.
//   3. mcp-merge → config merge.
//   4. Unknown subcommand → error.

import "cmd_mcp.oo";
import "safe_merge.oo";

pub fn main(p: &ProcessCap, fw: &FsWriteCap, fr: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    if list_len(args) < 1 {
        return run_ooda_mcp(fw, fr, env, list_new(), p);
    }
    let sub: String = list_get(args, 0);
    if str_starts_with(sub, "-") {
        return run_ooda_mcp(fw, fr, env, args, p);
    }
    let rest: List[String] = list_slice(args, 1, list_len(args));
    if sub == "mcp" {
        return run_ooda_mcp(fw, fr, env, rest, p);
    }
    if sub == "mcp-merge" {
        return run_ooda_mcp_merge(fr, fw, rest);
    }
    return Err("mcp: unknown subcommand: " + sub);
}
