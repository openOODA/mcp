// # MCP mcp-merge CLI
//
// Logline: Inject the ooda MCP entry into an agent-tool JSON config under FsReadCap+FsWriteCap.
//
// Setup: Exit 0 = already present. Exit 1 = written. Exit 2 = error. No silent remap of 1 to 0.
//
// Beats:
//   1. Require a path.
//   2. Call safe_mcp_merge_file.
//   3. Exit with the file-level code.

import "safe_merge_core.oo";

fn cmd_safe_mcp_merge_arg_positional(args: List[String]) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if str_slice(a, 0, 1) != "-" { return a; }
        i = i + 1;
    }
    return "";
}

pub fn run_ooda_mcp_merge(fr: &FsReadCap, fw: &FsWriteCap, args: List[String]) -> Result[Int, String] {
    let path: String = cmd_safe_mcp_merge_arg_positional(args);
    if chars_len(path) == 0 {
        return Err("usage: mcp mcp-merge <config.json>");
    }
    let rc: Int = safe_mcp_merge_file(fr, fw, path);
    if rc == 0 {
        println("noop\t" + path);
        return Ok(0);
    }
    if rc == 1 {
        println("merged\t" + path);
        return Ok(1);
    }
    return Err("mcp-merge failed: " + path);
}
