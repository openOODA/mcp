// # MCP Server CLI Command
//
// Logline: Route `mcp [--stdio | --file <path>]` into the transport dispatcher under FsWriteCap+FsReadCap+EnvCap+ProcessCap.
//
// Setup: Defaults to stdio. --socket is absent. OODACODEX is required by the server.
//
// Beats:
//   1. Parse --stdio, --file, or --help.
//   2. Reject unknown flags and missing paths.
//   3. --file runs mcp_server_run and print. Default runs mcp_stdio_serve.

import "engine/core/mcp_server.oo";
import "engine/core/mcp_transport.oo";
import "engine/core/mcp_stdio.oo";

fn cmd_mcp_has_flag(args: List[String], flag: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == flag { return true; }
        i = i + 1;
    }
    return false;
}

fn cmd_mcp_arg_value(args: List[String], flag: String) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i + 1 < n {
        if list_get(args, i) == flag { return list_get(args, i + 1); }
        i = i + 1;
    }
    return "";
}

pub fn run_ooda_mcp(fw: &FsWriteCap, fr: &FsReadCap, env: &EnvCap, args: List[String], p: &ProcessCap) -> Result[Int, String] {
    if cmd_mcp_has_flag(args, "--help") || cmd_mcp_has_flag(args, "-h") {
        println("mcp — openOODA MCP stdio|file server");
        println("usage: mcp [--stdio | --file <path>]");
        println("requires: OODACODEX=<path-to-codex>");
        return Ok(0);
    }
    let has_stdio: Bool = cmd_mcp_has_flag(args, "--stdio");
    let has_file: Bool = cmd_mcp_has_flag(args, "--file");
    if has_stdio && has_file {
        return Err("mcp: --stdio and --file are mutually exclusive");
    }
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--stdio" { i = i + 1; continue; }
        if a == "--file" {
            if i + 1 >= n || str_starts_with(list_get(args, i + 1), "--") {
                return Err("mcp: --file requires <path>");
            }
            i = i + 2;
            continue;
        }
        if str_starts_with(a, "--") { return Err("mcp: unknown flag " + a); }
        i = i + 1;
    }
    let file_path: String = cmd_mcp_arg_value(args, "--file");
    if chars_len(file_path) > 0 {
        let t: McpTransport = mcp_transport_file(file_path);
        let out_r: Result[String, String] = mcp_server_run(fw, fr, env, &t, p);
        if out_r.is_err() {
            let e: String = match out_r { Ok(_) => "", Err(m) => m };
            return Err("mcp: " + e);
        }
        let out: String = match out_r { Ok(s) => s, Err(_) => "" };
        if chars_len(out) > 0 { print(out); }
        return Ok(0);
    }
    return mcp_stdio_serve(fw, fr, env, p);
}
